@model tclcnigeria.Models.BibleSchoolApplication
@{
    ViewData["Title"] = "Bible School Application";
}

<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="eyebrow" style="color:var(--yellow);">Grow In The Word</span>
        <h1 class="mt-2 mb-3">Apply to <em>Lord's City Bible School</em></h1>
        <p>Study to show yourself approved. Take the next step in your knowledge of God's Word.</p>
    </div>
</section>

<section style="padding:5rem 0;">
    <div class="container">

        @if (ViewBag.Success != null)
        {
            <div style="background:linear-gradient(135deg,#d1fae5,#a7f3d0);
                border:1px solid #6ee7b7;border-radius:var(--r);
                color:#065f46;padding:1.5rem 2rem;margin-bottom:2rem;
                display:flex;align-items:center;gap:1rem;">
                <span style="font-size:1.8rem;">&#128214;</span>
                <div>
                    <p class="fw-bold mb-0">Application Received!</p>
                    <p class="mb-0" style="font-size:.93rem;">@ViewBag.Success</p>
                </div>
            </div>
        }

        <div class="row g-5 justify-content-center">
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h4 style="font-family:var(--font-display);margin-bottom:.5rem;">
                        Bible School Application Form
                    </h4>
                    <p style="color:var(--text-mid);font-size:.93rem;margin-bottom:1.8rem;">
                        Fill in your details below. Our Bible School team will review your application.
                    </p>
                    <form method="post" action="/BibleSchool">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label" style="font-size:.88rem;font-weight:600;">Full Name</label>
                            <input type="text" name="FullName" class="form-control" placeholder="Your full name" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-size:.88rem;font-weight:600;">Email Address</label>
                            <input type="email" name="Email" class="form-control" placeholder="name@example.com" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-size:.88rem;font-weight:600;">Phone Number</label>
                            <input type="tel" name="Phone" class="form-control" placeholder="080..." required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="font-size:.88rem;font-weight:600;">Home Address (optional)</label>
                            <input type="text" name="Address" class="form-control" placeholder="Your address" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label" style="font-size:.88rem;font-weight:600;">Why do you want to join Bible School? (optional)</label>
                            <textarea name="Testimony" class="form-control" rows="5"
                                      placeholder="Tell us briefly about your interest..."></textarea>
                        </div>
                        <button type="submit" class="btn-submit">
                            <i class="bi bi-send-check me-2"></i>Submit Application
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div style="background:linear-gradient(135deg,var(--navy),var(--navy-mid));
                    border-radius:var(--r);padding:2.5rem;margin-bottom:1.5rem;">
                    <i class="bi bi-book-half" style="font-size:2rem;color:var(--yellow);"></i>
                    <p style="font-family:var(--font-display);font-size:1.1rem;font-style:italic;
                        color:var(--white);line-height:1.7;margin:1rem 0;">
                        &ldquo;Study to show yourself approved unto God, a workman that needeth not to be ashamed.&rdquo;
                    </p>
                    <p style="color:var(--yellow);font-size:.82rem;font-weight:600;margin:0;">
                        2 Timothy 2:15
                    </p>
                </div>
                <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                    box-shadow:var(--shadow-sm);border:1px solid rgba(201,184,232,.3);">
                    <h6 class="fw-bold mb-3" style="font-family:var(--font-display);">What Happens Next</h6>
                    <div class="d-flex gap-3 mb-3">
                        <div style="width:32px;height:32px;border-radius:50%;background:var(--lilac-soft);
                            display:flex;align-items:center;justify-content:center;
                            color:var(--brand-blue);font-weight:700;flex-shrink:0;font-size:.85rem;">1</div>
                        <p style="color:var(--text-mid);font-size:.88rem;margin:0;padding-top:4px;">
                            Your application is received by the Bible School office
                        </p>
                    </div>
                    <div class="d-flex gap-3 mb-3">
                        <div style="width:32px;height:32px;border-radius:50%;background:var(--lilac-soft);
                            display:flex;align-items:center;justify-content:center;
                            color:var(--brand-blue);font-weight:700;flex-shrink:0;font-size:.85rem;">2</div>
                        <p style="color:var(--text-mid);font-size:.88rem;margin:0;padding-top:4px;">
                            It's reviewed by our Bible School leadership team
                        </p>
                    </div>
                    <div class="d-flex gap-3">
                        <div style="width:32px;height:32px;border-radius:50%;background:var(--yellow-soft);
                            display:flex;align-items:center;justify-content:center;
                            color:var(--navy);font-weight:700;flex-shrink:0;font-size:.85rem;">3</div>
                        <p style="color:var(--text-mid);font-size:.88rem;margin:0;padding-top:4px;">
                            You'll be contacted with the outcome of your application
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
