@model IEnumerable<tclcnigeria.Models.ChurchEvent>

@{
    ViewData["Title"] = "Events Admin";
}

<div class="container" style="padding:4rem 0;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="font-family:var(--font-display);margin:0;">Church Events</h2>
        <a href="/EventsAdmin/Create" style="background:var(--navy);color:#fff;border-radius:50px;padding:10px 24px;font-weight:600;text-decoration:none;">+ Add New Event</a>
    </div>
    @if (!Model.Any())
    {
        <p style="color:var(--text-mid);">No events yet. Click Add New Event to get started.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead style="background:var(--navy);">
                    <tr>
                        <th style="color:#fff;">Title</th>
                        <th style="color:#fff;">Date</th>
                        <th style="color:#fff;">Location</th>
                        <th style="color:#fff;">Category</th>
                        <th style="color:#fff;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>@ev.Title</td>
                            <td>@ev.EventDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@ev.Location</td>
                            <td>@ev.Category</td>
                            <td>
                                <a href="/EventsAdmin/Edit/@ev.Id" style="color:var(--brand-blue);margin-right:12px;font-weight:600;">Edit</a>
                                <a href="/EventsAdmin/DeleteConfirm/@ev.Id" style="color:#dc2626;font-weight:600;" onclick="return confirm('Delete this event?')">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
