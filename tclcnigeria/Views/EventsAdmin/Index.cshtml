@model IEnumerable<tclcnigeria.Models.ChurchEvent>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Events</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add New Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">No events found. Click "Add New Event" to create one.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Featured</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in Model.OrderBy(e => e.EventDate))
                    {
                        <tr>
                            <td>@evt.Title</td>
                            <td>@evt.EventDate.ToString("dd MMM yyyy, h:mm tt")</td>
                            <td>@evt.Location</td>
                            <td>@evt.Category</td>
                            <td>
                                @if (evt.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark">Featured</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@evt.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>