@model IEnumerable<tclcnigeria.Models.CtgEnrollment>
@{
    ViewData["Title"] = "Workforce Enrollments";
}
<div class="container py-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-gear-fill"></i> Workforce (C.T.G.) Enrollments</h2>
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Applied</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Department</th>
                <th>Status</th>
                <th>Reviewed By</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string rowStyle = item.Status == "Pending" ? "table-warning" : "";
                <tr class="@rowStyle">
                    <td>@item.AppliedAt.ToString("MMM dd, yyyy HH:mm")</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@(item.DepartmentInterest ?? "-")</td>
                    <td>
                        @if (item.Status == "Approved")
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (item.Status == "Rejected")
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                    <td>@(item.ReviewedBy ?? "-")</td>
                    <td>
                        @if (item.Status == "Pending")
                        {
                            <form method="post" action="/WorkforceAdmin/Approve" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form method="post" action="/WorkforceAdmin/Reject" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">@item.ReviewedAt?.ToString("MMM dd, yyyy")</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
