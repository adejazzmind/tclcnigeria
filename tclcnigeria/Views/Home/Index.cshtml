@{
    ViewData["Title"] = "Home";
}

<!-- HERO CAROUSEL -->
<section class="hero-carousel-section">
    <div id="tclcHeroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5500">

        <!-- Indicators -->
        <div class="carousel-indicators tclc-indicators">
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="2"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="3"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="4"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="5"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="6"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="7"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="8"></button>
        </div>

        <div class="carousel-inner">

            <!-- Slide 1 -->
            <div class="carousel-item active">
                <div class="hero-slide" style="background-image:url('/images/slides/slide1.jpg');">
                    <div class="hero-slide-overlay"></div>
                    <div class="container hero-slide-content">
                        <div class="hero-badge fade-up">&#10022; The City of the Lord Church Nigeria</div>
                        <h1 class="hero-title fade-up delay-1">Bringing <span>Healing</span> to<br>the Nations</h1>
                        <p class="hero-subtitle fade-up delay-2">Building a total man, restoring people to their destinies, and teaching the uncompromised Word of God.</p>
                        <div class="d-flex flex-wrap gap-3 fade-up delay-3">
                            <a asp-controller="Home" asp-action="Sermons" class="btn-hero-primary"><i class="bi bi-play-circle me-2"></i>Watch Sermons</a>
                            <a asp-controller="Home" asp-action="About" class="btn-hero-outline">Our Story <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image:url('/images/slides/slide2.jpg');">
                    <div class="hero-slide-overlay"></div>
                    <div class="container hero-slide-content">
                        <div class="hero-badge">&#10022; Join Us This Sunday</div>
                        <h1 class="hero-title">A Family That <span>Worships</span><br>Together</h1>
                        <p class="hero-subtitle">Experience passionate, Spirit-filled worship every Sunday at 9:00 AM in Ogba, Lagos.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Home" asp-action="Contact" class="btn-hero-primary"><i class="bi bi-geo-alt me-2"></i>Plan Your Visit</a>
                            <a asp-controller="Home" asp-action="Ministries" class="btn-hero-outline">Our Ministries <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 3 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image:url('/images/slides/slide3.jpg');">
                    <div class="hero-slide-overlay"></div>
                    <div class="container hero-slide-content">
                        <div class="hero-badge">&#10022; The Uncompromised Word</div>
                        <h1 class="hero-title">Teaching That <span>Transforms</span><br>Lives</h1>
                        <p class="hero-subtitle">Sound, Spirit-led Bible teaching that equips you to live victoriously every day.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Home" asp-action="Sermons" class="btn-hero-primary"><i class="bi bi-book-half me-2"></i>Browse Sermons</a>
                            <a asp-controller="Home" asp-action="About" class="btn-hero-outline">What We Believe <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 4 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image:url('/images/slides/slide4.jpg');">
                    <div class="hero-slide-overlay"></div>
                    <div class="container hero-slide-content">
                        <div class="hero-badge">&#10022; Raising Champions</div>
                        <h1 class="hero-title">A Place For <span>Every</span><br>Generation</h1>
                        <p class="hero-subtitle">From children's church to youth ministry, there's a home for your whole family.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Home" asp-action="Ministries" class="btn-hero-primary"><i class="bi bi-people-fill me-2"></i>See Ministries</a>
                            <a asp-controller="Events" asp-action="Index" class="btn-hero-outline">Upcoming Events <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 5 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image:url('/images/slides/slide5.jpg');">
                    <div class="hero-slide-overlay"></div>
                    <div class="container hero-slide-content">
                        <div class="hero-badge">&#10022; Prayer Changes Things</div>
                        <h1 class="hero-title">We Stand <span>With You</span><br>In Prayer</h1>
                        <p class="hero-subtitle">Submit a prayer request and our intercessory team will pray with you for 30 days.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Prayer" asp-action="Index" class="btn-hero-primary"><i class="bi bi-send-heart me-2"></i>Send a Prayer Request</a>
                            <a asp-controller="Home" asp-action="Contact" class="btn-hero-outline">Talk To Us <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 6 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image:url('/images/slides/slide6.jpg');">
                    <div class="hero-slide-overlay"></div>
                    <div class="container hero-slide-content">
                        <div class="hero-badge">&#10022; Sow Into The Vision</div>
                        <h1 class="hero-title">Give <span>Generously</span><br>From The Heart</h1>
                        <p class="hero-subtitle">Your giving advances the Gospel in Lagos and beyond. Give securely online in seconds.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Give" asp-action="Index" class="btn-hero-primary"><i class="bi bi-heart-fill me-2"></i>Give Online</a>
                            <a asp-controller="Home" asp-action="About" class="btn-hero-outline">Why We Give <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 7 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image:url('/images/slides/slide7.jpg');background-position:center 35%;">
                    <div class="hero-slide-overlay"></div>
                    <div class="container hero-slide-content">
                        <div class="hero-badge">&#10022; Led By The Spirit</div>
                        <h1 class="hero-title">Mighty Moves of <span>His Presence</span></h1>
                        <p class="hero-subtitle">Encounter the manifest presence and power of God in every service.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Home" asp-action="Sermons" class="btn-hero-primary"><i class="bi bi-play-circle me-2"></i>Watch Online</a>
                            <a asp-controller="Home" asp-action="Contact" class="btn-hero-outline">Visit a Service <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 8 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image:url('/images/slides/slide8.jpg');">
                    <div class="hero-slide-overlay"></div>
                    <div class="container hero-slide-content">
                        <div class="hero-badge">&#10022; Reaching The Lost</div>
                        <h1 class="hero-title">Taking the Gospel <span>Beyond Walls</span></h1>
                        <p class="hero-subtitle">Join our outreach team and help us bring Christ's love to our community and the nations.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Home" asp-action="Ministries" class="btn-hero-primary"><i class="bi bi-hand-thumbs-up me-2"></i>Join Outreach</a>
                            <a asp-controller="Home" asp-action="Contact" class="btn-hero-outline">Get Involved <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            

            <!-- Slide 10 -->
            <div class="carousel-item">
                <div class="hero-slide" style="background-image:url('/images/slides/slide10.jpg');">
                    <div class="hero-slide-overlay"></div>
                    <div class="container hero-slide-content">
                        <div class="hero-badge">&#10022; Welcome Home</div>
                        <h1 class="hero-title">You Belong <span>Here</span></h1>
                        <p class="hero-subtitle">Whoever you are, wherever you've been — there's a seat for you at TCLC Nigeria.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="Home" asp-action="Contact" class="btn-hero-primary"><i class="bi bi-door-open me-2"></i>Plan Your Visit</a>
                            <a asp-controller="Home" asp-action="Index" class="btn-hero-outline">Explore TCLC <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide="prev">
            <span class="tclc-carousel-arrow"><i class="bi bi-chevron-left"></i></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide="next">
            <span class="tclc-carousel-arrow"><i class="bi bi-chevron-right"></i></span>
        </button>
    </div>
</section>

<!-- SERVICE CARDS -->
<section class="container hero-stats pb-2">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="stat-card fade-up delay-1">
                <div class="stat-icon"><i class="bi bi-calendar-check"></i></div>
                <h5 class="fw-bold mb-1" style="font-family:var(--font-display);">Sunday Service</h5>
                <p class="mb-0" style="color:var(--text-mid);font-size:.95rem;">1st Service &middot; 7:00&ndash;9:00 AM<br>2nd Service &middot; 10:00&ndash;11:30 AM</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card fade-up delay-2">
                <div class="stat-icon"><i class="bi bi-book-half"></i></div>
                <h5 class="fw-bold mb-1" style="font-family:var(--font-display);">Mid-Week Service</h5>
                <p class="mb-0" style="color:var(--text-mid);font-size:.95rem;">Wednesdays &middot; 10:00 AM Faith Clinic &amp; 6:00 PM Bible Study</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card fade-up delay-3">
                <div class="stat-icon"><i class="bi bi-geo-alt"></i></div>
                <h5 class="fw-bold mb-1" style="font-family:var(--font-display);">Our Location</h5>
                <p class="mb-0" style="color:var(--text-mid);font-size:.92rem;">
                    25, Kudirat Soule Street, Ifako, Ogba, Lagos
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ABOUT STRIP -->
<section style="padding:6rem 0 5rem;">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div style="position:relative;border-radius:24px;overflow:hidden;box-shadow:var(--shadow-lg);">
                    <img src="/images/slides/slide1.jpg" alt="TCLC Nigeria congregation" style="width:100%;height:100%;object-fit:cover;" />
                </div>
            </div>
            <div class="col-lg-6">
                <h2 style="font-family:var(--font-display);">There's a Place for <em>You</em> Here</h2>
                <p style="color:var(--text-mid);font-size:1.02rem;margin-top:1rem;">
                    Whether you're new to faith or have walked with God for years, TCLC Nigeria is a home
                    for you. Join us as we grow together in worship, community, and purpose.
                </p>
            </div>
        </div>
        <div class="divider"></div>
        <div class="row g-4">
            <div class="col-md-4">
                <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                    box-shadow:var(--shadow-sm);border:1px solid rgba(201,184,232,.2);transition:all .3s ease;"
                     onmouseover="this.style.transform='translateY(-5px)';this.style.boxShadow='var(--shadow-lg)'"
                     onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='var(--shadow-sm)'">
                    <div style="width:52px;height:52px;border-radius:14px;
                        background:linear-gradient(135deg,var(--lilac-soft),var(--light-blue));
                        display:flex;align-items:center;justify-content:center;
                        font-size:1.4rem;color:var(--brand-blue);margin-bottom:1rem;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5 style="font-family:var(--font-display);">Men's Ministry</h5>
                    <p style="color:var(--text-mid);font-size:.92rem;margin:0;">
                        Empowering men to lead with integrity, faith, and strength.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div style="background:linear-gradient(135deg,var(--navy),var(--brand-blue));
                    border-radius:var(--r);padding:2rem;box-shadow:var(--shadow-md);">
                    <div style="width:52px;height:52px;border-radius:14px;
                        background:rgba(245,200,66,.2);display:flex;align-items:center;
                        justify-content:center;font-size:1.4rem;color:var(--yellow);margin-bottom:1rem;">
                        <i class="bi bi-flower1"></i>
                    </div>
                    <h5 style="color:var(--white);font-family:var(--font-display);">Women of Glory</h5>
                    <p style="color:rgba(255,255,255,.75);font-size:.92rem;margin:0;">
                        Building faith-filled women through prayer and mentorship.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                    box-shadow:var(--shadow-sm);border:1px solid rgba(201,184,232,.2);transition:all .3s ease;"
                     onmouseover="this.style.transform='translateY(-5px)';this.style.boxShadow='var(--shadow-lg)'"
                     onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='var(--shadow-sm)'">
                    <div style="width:52px;height:52px;border-radius:14px;
                        background:linear-gradient(135deg,var(--yellow-soft),var(--lilac-soft));
                        display:flex;align-items:center;justify-content:center;
                        font-size:1.4rem;color:var(--navy);margin-bottom:1rem;">
                        <i class="bi bi-person-arms-up"></i>
                    </div>
                    <h5 style="font-family:var(--font-display);">The Peculiar Generation</h5>
                    <p style="color:var(--text-mid);font-size:.92rem;margin:0;">
                        Inspiring the next generation to find purpose in God's Word.
                    </p>
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Home" asp-action="Ministries"
               style="display:inline-flex;align-items:center;gap:8px;color:var(--brand-blue);
                font-weight:600;text-decoration:none;font-size:.95rem;">
                View All Ministries <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- CTA -->
<section style="padding:0 0 5rem;">
    <div class="container">
        <div style="background:linear-gradient(135deg,var(--lilac-soft),var(--yellow-soft));
            border-radius:24px;padding:4rem 3rem;text-align:center;
            border:1px solid rgba(201,184,232,.4);box-shadow:var(--shadow-md);">
            <span class="eyebrow">Join Us This Sunday</span>
            <h2 class="section-title mb-3">Experience the Presence of God</h2>
            <p style="color:var(--text-mid);font-size:1.05rem;max-width:520px;margin:0 auto 1rem;">
                25, Kudirat Soule Street, off Coker Street, Orimolade Bus Stop,<br>
                College Road, Ifako, Ogba, Lagos.
            </p>
            <p style="color:var(--brand-blue);font-weight:600;margin-bottom:2rem;">
                <i class="bi bi-telephone me-1"></i> 07082768005
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Contact"
                   style="display:inline-block;background:var(--navy);color:var(--white);
                    border-radius:50px;padding:14px 36px;font-weight:600;text-decoration:none;
                    box-shadow:0 8px 24px rgba(7,13,46,.2);transition:all .25s ease;"
                   onmouseover="this.style.background='var(--brand-blue)';this.style.transform='translateY(-2px)'"
                   onmouseout="this.style.background='var(--navy)';this.style.transform='translateY(0)'">
                    <i class="bi bi-envelope me-2"></i>Get In Touch
                </a>
                <a asp-controller="Prayer" asp-action="Index"
                   style="display:inline-block;background:transparent;color:var(--navy);
                    border:2px solid var(--navy);border-radius:50px;padding:14px 36px;
                    font-weight:600;text-decoration:none;transition:all .25s ease;"
                   onmouseover="this.style.background='var(--navy)';this.style.color='#fff'"
                   onmouseout="this.style.background='transparent';this.style.color='var(--navy)'">
                    <i class="bi bi-send-heart me-2"></i>Send a Prayer Request
                </a>
            </div>
        </div>
    </div>
</section>










