    <div id="tclcHeroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5500">

        <!-- Indicators -->
        <div class="carousel-indicators tclc-indicators">
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="2"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="3"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="4"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="5"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="6"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="7"></button>
            <button type="button" data-bs-target="#tclcHeroCarousel" data-bs-slide-to="8"></button>
