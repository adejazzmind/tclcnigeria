@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<section class="hero-hybrid">
    <div class="container hero-content">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <!-- Logo (Ensure you have this file or it will hide via onerror) -->
                <img src="~/images/tclc-logo.png" asp-append-version="true" alt="TCLC Logo" class="brand-logo" onerror="this.style.display='none'" />

                <div class="hero-badge">
                    <i class="bi bi-stars"></i> Welcome to TCLC Nigeria
                </div>

                <h1 class="hero-title">
                    Where <span class="text-gold">Faith</span> Grows <br />
                    & Lives Are <br />
                    Transformed
                </h1>

                <p class="hero-text">
                    Join a vibrant community of believers in Lagos, Nigeria — worshipping together,
                    growing in the Word, and serving our generation with love and power.
                </p>

                <div class="hero-actions">
                    <a asp-controller="Home" asp-action="Sermons" class="btn-hero-primary">
                        <i class="bi bi-play-circle me-2"></i>Watch Sermons
                    </a>
                    <a asp-controller="Home" asp-action="About" class="btn-hero-secondary">
                        Learn More <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FLOATING INFO CARDS -->
<div class="container info-cards-wrap">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="info-card gold">
                <div class="info-icon gold mx-auto"><i class="bi bi-calendar-check"></i></div>
                <h3 class="h3">Sunday Service</h3>
                <p class="mb-0 text-muted-custom">Every Sunday · 10:00 AM</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-card purple">
                <div class="info-icon purple mx-auto"><i class="bi bi-geo-alt"></i></div>
                <h3 class="h3">Location</h3>
                <p class="mb-0 text-muted-custom">25, Kudirat Soule Str,<br />Ifako/Ogba, Lagos</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="info-card green">
                <div class="info-icon green mx-auto"><i class="bi bi-envelope"></i></div>
                <h3 class="h3">Contact Us</h3>
                <p class="mb-0 text-muted-custom">+234 808 883 4964<br />tclcnigeria@gmail.com</p>
            </div>
        </div>
    </div>
</div>

<!-- FOUNDER SECTION -->
<section class="py-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <!-- Image is set in CSS (.founder-image-box) -->
                <div class="founder-image-box"></div>
            </div>

            <div class="col-lg-6">
                <div class="section-eyebrow" style="color: var(--gold);">Meet Our Leader</div>
                <h2 class="section-title left">Rev. Dr. J.S.A Oladele</h2>
                <p class="fs-5 text-muted-custom">
                    Founder & General Overseer of The City Of The Lord Church Nigeria.
                </p>

                <p class="text-muted-custom">
                    With a mandate to proclaim the love of Christ and bring healing to the nations,
                    Rev. Oladele has dedicated his life to building total men and restoring destinies
                    through the uncompromised Word of God.
                </p>

                <div class="mt-4 mb-4">
                    <div class="highlight-pill"><i class="bi bi-check-circle-fill text-emerald"></i> Word of God</div>
                    <div class="highlight-pill"><i class="bi bi-check-circle-fill text-orange"></i> Holy Spirit</div>
                    <div class="highlight-pill"><i class="bi bi-check-circle-fill text-purple"></i> Healing & Destiny</div>
                </div>

                <a asp-controller="Home" asp-action="About" class="btn btn-outline-dark rounded-pill px-4 py-2">
                    Read Full Biography
                </a>
            </div>
        </div>
    </div>
</section>

<!-- MINISTRIES SECTION -->
<section class="py-section bg-light">
    <div class="container text-center">
        <div class="section-eyebrow">Get Involved</div>
        <h2 class="section-title center">Our Ministries</h2>
        <p class="text-muted-custom mb-5">There is a place for you to grow, serve, and connect at TCLC.</p>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="ministry-card">
                    <div class="ministry-icon bg-icon-navy mx-auto"><i class="bi bi-people-fill"></i></div>
                    <h4>Men's Fellowship</h4>
                    <p class="mb-0 text-muted-custom">Leading with integrity and strength.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ministry-card">
                    <div class="ministry-icon bg-icon-purple mx-auto"><i class="bi bi-flower1"></i></div>
                    <h4>Women's Ministry</h4>
                    <p class="mb-0 text-muted-custom">Faith, prayer, and excellence.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ministry-card">
                    <div class="ministry-icon bg-icon-gold mx-auto"><i class="bi bi-person-arms-up"></i></div>
                    <h4>Youth Ministry</h4>
                    <p class="mb-0 text-muted-custom">Passion, purpose, and power.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ministry-card">
                    <div class="ministry-icon bg-icon-green mx-auto"><i class="bi bi-music-note-beamed"></i></div>
                    <h4>Choir & Arts</h4>
                    <p class="mb-0 text-muted-custom">Worshiping in spirit and truth.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ministry-card">
                    <div class="ministry-icon bg-icon-purple mx-auto"><i class="bi bi-book"></i></div>
                    <h4>Children's Church</h4>
                    <p class="mb-0 text-muted-custom">Building foundations of faith.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ministry-card">
                    <div class="ministry-icon bg-icon-gold mx-auto"><i class="bi bi-megaphone"></i></div>
                    <h4>Evangelism</h4>
                    <p class="mb-0 text-muted-custom">Reaching the lost with love.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- GIVING SECTION -->
<section class="dark-feature-section py-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-5">
                <h2 class="section-title left text-white">Partner With Us</h2>
                <p class="fs-4 text-white-50 fst-italic">"Give, and it will be given to you..." – Luke 6:38</p>
                <p class="text-white-50 mb-0">
                    Support the vision of healing nations through your tithes and offerings.
                </p>
            </div>

            <div class="col-lg-7">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="giving-card">
                            <h5 class="text-gold text-uppercase fw-bold ls-1">Tithes</h5>
                            <p class="mb-1 fw-bold text-muted-custom small">Union Bank</p>
                            <div class="giving-account">0006520956</div>
                            <p class="mb-0 small text-muted-custom">The City Of The Lord Church Nigeria</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="giving-card">
                            <h5 class="text-purple text-uppercase fw-bold ls-1">Offerings</h5>
                            <p class="mb-1 fw-bold text-muted-custom small">Polaris Bank</p>
                            <div class="giving-account">1771157918</div>
                            <p class="mb-0 small text-muted-custom">The City Of The Lord Church Nigeria</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA SECTION -->
<section class="py-section">
    <div class="container">
        <div class="premium-cta">
            <div class="section-eyebrow">Join Us This Sunday</div>
            <h2 class="section-title center">Experience the Presence of God</h2>
            <p class="text-muted-custom mx-auto" style="max-width:700px;">
                Everyone is welcome at TCLC Nigeria. Come as you are and encounter the love of God
                in a warm, Spirit-filled atmosphere.
            </p>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-dark rounded-pill px-4 py-3 mt-3">
                <i class="bi bi-envelope me-2"></i>Get In Touch
            </a>
        </div>
    </div>
</section>