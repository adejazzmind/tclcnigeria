@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<div class="bg-dark text-white py-5 mb-0" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/images/church-hero.jpg') center/cover; min-height: 400px;">
    <div class="container py-5 text-center">
        <h1 class="display-3 fw-bold">Welcome to TCLCNigeria</h1>
        <p class="lead mb-4">A place where faith grows and lives are transformed. Join us as we worship and grow in the word of God.</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Home" asp-action="Sermons" class="btn btn-primary btn-lg px-4 gap-3 shadow">Watch Sermons</a>
            <a asp-controller="Home" asp-action="About" class="btn btn-outline-light btn-lg px-4">Learn More</a>
        </div>
    </div>
</div>

<!-- INFO CARDS SECTION - Forced spacing -->
<div class="container py-5" style="min-height: 400px;">
    <div class="row g-4 justify-content-center">
        <!-- Sunday Service -->
        <div class="col-md-4">
            <div class="card h-100 border shadow-sm text-center p-4 bg-white">
                <div class="card-body">
                    <div class="display-6 text-primary mb-3">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Sunday Service</h3>
                    <p class="text-muted">9:00 AM - 11:30 AM</p>
                </div>
            </div>
        </div>

        <!-- Mid-Week Study -->
        <div class="col-md-4">
            <div class="card h-100 border shadow-sm text-center p-4 bg-white">
                <div class="card-body">
                    <div class="display-6 text-primary mb-3">
                        <i class="bi bi-book"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Mid-Week Study</h3>
                    <p class="text-muted">Wednesdays | 6:00 PM</p>
                </div>
            </div>
        </div>

        <!-- Location -->
        <div class="col-md-4">
            <div class="card h-100 border shadow-sm text-center p-4 bg-white">
                <div class="card-body">
                    <div class="display-6 text-primary mb-3">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Location</h3>
                    <p class="text-muted">Lagos, Nigeria</p>
                </div>
            </div>
        </div>
    </div>
</div>