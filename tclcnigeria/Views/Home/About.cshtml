@{
    ViewData["Title"] = "About Us";
}

<!-- PAGE HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="eyebrow" style="color:var(--yellow);">Who We Are</span>
        <h1 class="mt-2 mb-3">The City of the <em>Lord Church</em></h1>
        <p>Headquartered in Lagos, Nigeria &mdash; mandated by God to make disciples of all nations.</p>
    </div>
</section>

<section style="padding:5rem 0;">
    <div class="container">

        <!-- WHY OUR CHURCH -->
        <div class="row align-items-center g-5" style="margin-bottom:5rem;">
            <div class="col-lg-12">
                <span class="eyebrow">Why Our Church</span>
                <h2 class="section-title mb-3">
                    We believe and preach the Gospel of Jesus Christ,
                    Who is our <em>Lord and Savior.</em>
                </h2>
                <div class="divider" style="margin-left:0;"></div>
                <p style="color:var(--text-mid);font-size:1.05rem;line-height:1.9;">
                    We are a Priest, and a Peculiar People of God. Christ in us is our Hope of Glory.
                    The Lord lives within us and we rejoice in His presence always.
                </p>
                <a asp-controller="Home" asp-action="Contact"
                   style="display:inline-flex;align-items:center;gap:8px;margin-top:1rem;
                    background:var(--navy);color:var(--white);border-radius:50px;
                    padding:13px 32px;font-weight:600;text-decoration:none;
                    box-shadow:0 6px 20px rgba(7,13,46,.2);transition:all .25s;"
                   onmouseover="this.style.background='var(--brand-blue)';this.style.transform='translateY(-2px)'"
                   onmouseout="this.style.background='var(--navy)';this.style.transform='translateY(0)'">
                    Join Us This Sunday <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- MEET OUR FOUNDER -->
        <div style="background:linear-gradient(135deg,var(--navy),var(--navy-mid));
            border-radius:24px;padding:4rem;margin-bottom:5rem;position:relative;overflow:hidden;">
            <div style="position:absolute;top:-60px;right:-60px;width:300px;height:300px;
                border-radius:50%;background:rgba(245,200,66,.06);"></div>
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="eyebrow" style="color:var(--yellow);">Meet Our Founder</span>
                    <h2 style="color:var(--white);font-family:var(--font-display);font-size:2.2rem;margin-bottom:1.5rem;">
                        Rev. Dr. J.S.A Oladele
                    </h2>
                    <p style="color:rgba(255,255,255,.8);font-size:1rem;line-height:1.9;margin-bottom:1.2rem;">
                        Rev. J.S.A Oladele is the Founder &amp; General Overseer of The City of The Lord Church
                        (Eternal Life Parish), founded with the vision of bringing healing to the nations of the
                        world, with the mandate of proclaiming the love of Christ. Building a total man, restoring
                        people to their destinies, by teaching the uncompromised Word of God and manifestations of
                        the power and gifts of the Holy Ghost.
                    </p>
                    <p style="color:rgba(255,255,255,.75);font-size:1rem;line-height:1.9;margin:0;">
                        Our Founder believes in the present ministry and baptism of the Holy Spirit, by whose
                        indwelling the Christian is enabled to live a Godly life. He believes in the resurrection
                        of both the saved and the unsaved; those saved into the resurrection of life and those
                        unsaved into the resurrection of damnation.
                    </p>
                </div>
                <div class="col-lg-5 text-center">
                    <div style="width:260px;height:300px;border-radius:20px;overflow:hidden;margin:0 auto;
                        box-shadow:0 20px 60px rgba(0,0,0,.4);border:3px solid rgba(245,200,66,.4);">
                        <img src="data:image/jpeg;base64,"
                             alt="Rev. Dr. J.S.A Oladele"
                             style="width:100%;height:100%;object-fit:cover;object-position:top center;">
                    </div>
                    <div style="background:rgba(255,255,255,.08);border-radius:14px;padding:12px 24px;
                        margin:16px auto 0;display:inline-block;border-top:3px solid var(--yellow);">
                        <p class="fw-bold mb-0" style="color:var(--white);font-size:.95rem;">Rev. Dr. J.S.A Oladele</p>
                        <p style="color:var(--yellow);font-size:.78rem;font-weight:600;
                            text-transform:uppercase;letter-spacing:1px;margin:0;">General Overseer</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- VISION & MISSION -->
        <div class="text-center mb-5">
            <span class="eyebrow">Our Direction</span>
            <h2 class="section-title">Vision &amp; <em>Mission</em></h2>
            <div class="divider"></div>
        </div>
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div style="background:linear-gradient(135deg,var(--navy),var(--brand-blue));
                    border-radius:var(--r);padding:3rem;height:100%;">
                    <div style="width:56px;height:56px;border-radius:14px;background:rgba(245,200,66,.2);
                        display:flex;align-items:center;justify-content:center;
                        font-size:1.5rem;color:var(--yellow);margin-bottom:1.5rem;">
                        <i class="bi bi-eye"></i>
                    </div>
                    <h3 style="color:var(--white);font-family:var(--font-display);margin-bottom:1rem;">Our Vision</h3>
                    <p style="color:rgba(255,255,255,.78);font-size:1rem;line-height:1.9;margin:0;">
                        Bringing healing to the nations of the world, building a total man, restoring people
                        to their destinies, teaching the uncompromised Word of God, and manifestations of the
                        power and gifts of the Holy Ghost.
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div style="background:linear-gradient(135deg,var(--lilac-soft),var(--light-blue));
                    border-radius:var(--r);padding:3rem;height:100%;border:1px solid rgba(201,184,232,.4);">
                    <div style="width:56px;height:56px;border-radius:14px;
                        background:linear-gradient(135deg,var(--brand-blue),var(--navy));
                        display:flex;align-items:center;justify-content:center;
                        font-size:1.5rem;color:var(--white);margin-bottom:1.5rem;">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <h3 style="color:var(--navy);font-family:var(--font-display);margin-bottom:1rem;">Our Mission</h3>
                    <p style="color:var(--text-mid);font-size:1rem;line-height:1.8;margin:0 0 1rem;">
                        To empower and equip members to live victoriously, by engaging the following kingdom forces:
                    </p>
                    <ul style="color:var(--text-mid);font-size:.97rem;line-height:2.3;padding-left:1.2rem;margin:0;">
                        <li>The Word of God</li>
                        <li>Prayer and Fasting</li>
                        <li>Reaching out to the lost</li>
                        <li>Giving generously</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- WHAT WE BELIEVE -->
        <div style="background:linear-gradient(135deg,var(--lilac-soft),var(--yellow-soft));
            border-radius:24px;padding:4rem;margin-bottom:5rem;border:1px solid rgba(201,184,232,.3);">
            <div class="text-center mb-5">
                <span class="eyebrow">Our Doctrine</span>
                <h2 class="section-title">What We <em>Believe</em></h2>
                <div class="divider"></div>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                        box-shadow:var(--shadow-sm);height:100%;border-top:4px solid var(--brand-blue);">
                        <div style="width:48px;height:48px;border-radius:12px;
                            background:linear-gradient(135deg,var(--lilac-soft),var(--light-blue));
                            display:flex;align-items:center;justify-content:center;
                            font-size:1.3rem;color:var(--brand-blue);margin-bottom:1rem;">
                            <i class="bi bi-book-half"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">The Holy Scripture</h5>
                        <p style="color:var(--text-mid);font-size:.92rem;line-height:1.8;margin:0;">
                            We believe the Bible to be the inspired, the only infallible, authoritative Word of God
                            and inerrant in the original writings.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                        box-shadow:var(--shadow-sm);height:100%;border-top:4px solid var(--yellow);">
                        <div style="width:48px;height:48px;border-radius:12px;background:rgba(245,200,66,.15);
                            display:flex;align-items:center;justify-content:center;
                            font-size:1.3rem;color:var(--navy);margin-bottom:1rem;">
                            <i class="bi bi-diagram-3"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">The Trinity</h5>
                        <p style="color:var(--text-mid);font-size:.92rem;line-height:1.8;margin:0;">
                            We believe that there is one God, eternally existing in three persons:
                            Father, Son, and Holy Spirit.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                        box-shadow:var(--shadow-sm);height:100%;border-top:4px solid var(--lilac);">
                        <div style="width:48px;height:48px;border-radius:12px;background:var(--lilac-soft);
                            display:flex;align-items:center;justify-content:center;
                            font-size:1.3rem;color:var(--brand-blue);margin-bottom:1rem;">
                            <i class="bi bi-person-check"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">The Deity of Christ</h5>
                        <p style="color:var(--text-mid);font-size:.92rem;line-height:1.8;margin:0;">
                            We believe in the deity of our Lord Jesus Christ, His virgin birth, sinless life,
                            miracles, vicarious death, bodily resurrection, and personal return in power and glory.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                        box-shadow:var(--shadow-sm);height:100%;border-top:4px solid var(--sky);">
                        <div style="width:48px;height:48px;border-radius:12px;background:var(--light-blue);
                            display:flex;align-items:center;justify-content:center;
                            font-size:1.3rem;color:var(--navy);margin-bottom:1rem;">
                            <i class="bi bi-droplet-half"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Redemption</h5>
                        <p style="color:var(--text-mid);font-size:.92rem;line-height:1.8;margin:0;">
                            We believe that the lost and sinful man must be saved, and that man's only hope of
                            redemption is through the shed blood of Jesus Christ, the Son of God.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                        box-shadow:var(--shadow-sm);height:100%;border-top:4px solid var(--brand-blue);">
                        <div style="width:48px;height:48px;border-radius:12px;
                            background:linear-gradient(135deg,var(--lilac-soft),var(--light-blue));
                            display:flex;align-items:center;justify-content:center;
                            font-size:1.3rem;color:var(--brand-blue);margin-bottom:1rem;">
                            <i class="bi bi-wind"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">The Holy Spirit</h5>
                        <p style="color:var(--text-mid);font-size:.92rem;line-height:1.8;margin:0;">
                            We believe in the present ministry and baptism of the Holy Spirit, by whose indwelling
                            the Christian is enabled to live a Godly and victorious life.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                        box-shadow:var(--shadow-sm);height:100%;border-top:4px solid var(--yellow);">
                        <div style="width:48px;height:48px;border-radius:12px;background:rgba(245,200,66,.15);
                            display:flex;align-items:center;justify-content:center;
                            font-size:1.3rem;color:var(--navy);margin-bottom:1rem;">
                            <i class="bi bi-stars"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Resurrection</h5>
                        <p style="color:var(--text-mid);font-size:.92rem;line-height:1.8;margin:0;">
                            We believe in the resurrection of both the saved and the unsaved &mdash; those saved into
                            the resurrection of life, and those unsaved into the resurrection of damnation.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- LEADERSHIP -->
        <div class="text-center mb-5">
            <span class="eyebrow">Our Leadership</span>
            <h2 class="section-title">Guided by Faith, <em>Led by the Spirit</em></h2>
            <div class="divider"></div>
        </div>
        <div class="row justify-content-center g-4 mb-5">

            <!-- Pastor O.K. Obasa -->
            <div class="col-md-5">
                <div class="pastor-card">
                    <img src="data:image/jpeg;base64,"
                         class="pastor-img"
                         alt="Pastor O.K. Obasa"
                         style="object-position:top center;">
                    <h4 style="font-family:var(--font-display);font-size:1.4rem;margin-bottom:.3rem;">Pastor O.K. Obasa</h4>
                    <p style="color:var(--brand-blue);font-weight:600;font-size:.88rem;
                        text-transform:uppercase;letter-spacing:1.5px;margin-bottom:1rem;">Senior Pastor</p>
                    <p style="color:var(--text-mid);font-size:.93rem;line-height:1.7;margin:0;">
                        Leading TCLC Nigeria with a heart for people and a passion for souls, teaching
                        the uncompromised Word of God with clarity and power.
                    </p>
                </div>
            </div>

            <!-- Pastor Funmi Oluwalade -->
            <div class="col-md-5">
                <div class="pastor-card">
                    <img src="data:image/jpeg;base64,"
                         class="pastor-img"
                         alt="Pastor Funmi Oluwalade"
                         style="object-position:top center;">
                    <h4 style="font-family:var(--font-display);font-size:1.4rem;margin-bottom:.3rem;">Pastor Funmi Oluwalade</h4>
                    <p style="color:var(--brand-blue);font-weight:600;font-size:.88rem;
                        text-transform:uppercase;letter-spacing:1.5px;margin-bottom:1rem;">Pastor / Teacher</p>
                    <p style="color:var(--text-mid);font-size:.93rem;line-height:1.7;margin:0;">
                        Known for deep, Spirit-filled teaching series, equipping believers for
                        victorious Christian living across the TCLC family.
                    </p>
                </div>
            </div>

        </div>

        <!-- SOCIAL MEDIA -->
        <div class="text-center">
            <span class="eyebrow">Stay Connected</span>
            <h3 class="section-title mb-4">Follow Us Online</h3>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="https://www.youtube.com/@@tclcnigeria" target="_blank"
                   style="display:inline-flex;align-items:center;gap:10px;background:var(--white);
                    border:1px solid rgba(201,184,232,.4);border-radius:50px;padding:12px 24px;
                    font-weight:600;font-size:.92rem;color:var(--text-dark);text-decoration:none;
                    box-shadow:var(--shadow-sm);transition:all .25s;"
                   onmouseover="this.style.background='#FF0000';this.style.color='#fff'"
                   onmouseout="this.style.background='var(--white)';this.style.color='var(--text-dark)'">
                    <i class="bi bi-youtube" style="font-size:1.2rem;"></i> YouTube &middot; @@tclcnigeria
                </a>
                <a href="https://instagram.com/tclcnigeria" target="_blank"
                   style="display:inline-flex;align-items:center;gap:10px;background:var(--white);
                    border:1px solid rgba(201,184,232,.4);border-radius:50px;padding:12px 24px;
                    font-weight:600;font-size:.92rem;color:var(--text-dark);text-decoration:none;
                    box-shadow:var(--shadow-sm);transition:all .25s;"
                   onmouseover="this.style.background='#E1306C';this.style.color='#fff'"
                   onmouseout="this.style.background='var(--white)';this.style.color='var(--text-dark)'">
                    <i class="bi bi-instagram" style="font-size:1.2rem;"></i> Instagram &middot; @@tclcnigeria
                </a>
                <a href="https://facebook.com/thecityofthelordchurch" target="_blank"
                   style="display:inline-flex;align-items:center;gap:10px;background:var(--white);
                    border:1px solid rgba(201,184,232,.4);border-radius:50px;padding:12px 24px;
                    font-weight:600;font-size:.92rem;color:var(--text-dark);text-decoration:none;
                    box-shadow:var(--shadow-sm);transition:all .25s;"
                   onmouseover="this.style.background='#1877F2';this.style.color='#fff'"
                   onmouseout="this.style.background='var(--white)';this.style.color='var(--text-dark)'">
                    <i class="bi bi-facebook" style="font-size:1.2rem;"></i> Facebook &middot; thecityofthelordchurch
                </a>
            </div>
        </div>

    </div>
</section>
