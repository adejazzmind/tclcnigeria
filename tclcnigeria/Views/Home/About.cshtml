@{
    ViewData["Title"] = "About Us";
}

<!-- ABOUT HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill">About TCLC Nigeria</span>
        <h1 class="mt-2">A Church With A <br /><em>Divine Mandate</em></h1>
        <p class="lead mx-auto" style="max-width: 700px;">
            Headquartered in Lagos, Nigeria, and mandated by God to make disciples of all nations.
        </p>
    </div>
</section>

<!-- VISION & MISSION -->
<section class="py-section" style="background: linear-gradient(135deg, rgba(217,203,255,.18), rgba(255,255,255,.95));">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="soft-panel panel-cream">
                    <div class="section-eyebrow" style="color: var(--gold);">Vision</div>
                    <h3>Bringing Healing To The Nations</h3>
                    <p class="mb-0 text-muted-custom">
                        Bringing healing to the nations of the world, building a total man,
                        restoring people to their destinies, teaching the uncompromised word of God
                        and manifestations of the power and gifts of the Holy Ghost.
                    </p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="soft-panel panel-lilac">
                    <div class="section-eyebrow">Mission</div>
                    <h3>Equipping Believers To Live Victoriously</h3>
                    <ul class="mb-0 text-muted-custom list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>The Word of God</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Prayer and Fasting</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-primary me-2"></i>Reaching out to the lost</li>
                        <li><i class="bi bi-check-circle-fill text-primary me-2"></i>Giving generously</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FOUNDER DETAILS -->
<section class="py-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <!-- Reusing the CSS class for consistent image -->
                <div class="founder-image-box"></div>
            </div>
            <div class="col-lg-7">
                <div class="section-eyebrow">Meet Our Founder</div>
                <h2 class="section-title left">Rev. Dr. J.S.A Oladele</h2>
                <p class="text-muted-custom">
                    Rev. Dr. J.S.A Oladele is the Founder & General Overseer of The City Of The Lord Church Nigeria,
                    called with the vision of bringing healing to the nations of the world and proclaiming the love of Christ.
                </p>
                <p class="text-muted-custom">
                    His ministry focuses on building a total man, restoring people to their destinies,
                    teaching the uncompromised Word of God, and demonstrating the power and gifts of the Holy Ghost.
                </p>
                <p class="text-muted-custom">
                    He believes in the present ministry and baptism of the Holy Spirit, by whose indwelling the Christian
                    is enabled to live a godly life, and in the resurrection of both the saved and the unsaved.
                </p>
            </div>
        </div>
    </div>
</section>