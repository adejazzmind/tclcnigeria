@{
    ViewData["Title"] = "About Us";
}

<!-- PAGE HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="eyebrow" style="color:var(--yellow);">Who We Are</span>
        <h1 class="mt-2 mb-3">A Community of <em>Believers</em></h1>
        <p>Dedicated to faith, growth, and transformation in Lagos, Nigeria.</p>
    </div>
</section>

<!-- MISSION & VISION -->
<section style="padding:5rem 0;">
    <div class="container">
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div style="background:linear-gradient(135deg,var(--navy),var(--brand-blue));
                    border-radius:var(--r);padding:3rem;height:100%;position:relative;overflow:hidden;">
                    <div style="position:absolute;top:-30px;right:-30px;width:180px;height:180px;
                    border-radius:50%;background:rgba(255,255,255,.05);"></div>
                    <div style="width:56px;height:56px;border-radius:14px;
                        background:rgba(245,200,66,.2);display:flex;align-items:center;
                        justify-content:center;font-size:1.5rem;color:var(--yellow);margin-bottom:1.5rem;">
                        <i class="bi bi-compass"></i>
                    </div>
                    <h3 style="color:var(--white);font-family:var(--font-display);">Our Mission</h3>
                    <p style="color:rgba(255,255,255,.78);font-size:1rem;line-height:1.8;margin:0;">
                        To reach the unreached with the gospel of Jesus Christ and to empower believers
                        to live lives of impact and purpose through the Word of God.
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div style="background:linear-gradient(135deg,var(--lilac-soft),var(--light-blue));
                    border-radius:var(--r);padding:3rem;height:100%;position:relative;overflow:hidden;
                    border:1px solid rgba(201,184,232,.4);">
                    <div style="position:absolute;top:-30px;right:-30px;width:180px;height:180px;
                    border-radius:50%;background:rgba(26,86,219,.06);"></div>
                    <div style="width:56px;height:56px;border-radius:14px;
                        background:linear-gradient(135deg,var(--brand-blue),var(--navy));
                        display:flex;align-items:center;justify-content:center;
                        font-size:1.5rem;color:var(--white);margin-bottom:1.5rem;">
                        <i class="bi bi-eye"></i>
                    </div>
                    <h3 style="color:var(--navy);font-family:var(--font-display);">Our Vision</h3>
                    <p style="color:var(--text-mid);font-size:1rem;line-height:1.8;margin:0;">
                        To build a global community of faith where lives are transformed, families are
                        strengthened, and hope is restored to the brokenhearted.
                    </p>
                </div>
            </div>
        </div>

        <!-- CORE VALUES -->
        <div class="text-center mb-5">
            <span class="eyebrow">What We Stand For</span>
            <h2 class="section-title">Our Core Values</h2>
            <div class="divider"></div>
        </div>
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="value-card">
                    <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;
                        background:linear-gradient(135deg,var(--brand-blue),var(--lilac));
                        -webkit-background-clip:text;-webkit-text-fill-color:transparent;
                        background-clip:text;line-height:1;margin-bottom:.5rem;">
                        01
                    </div>
                    <h5 class="fw-bold mb-2">Faith</h5>
                    <p style="color:var(--text-mid);font-size:.93rem;margin:0;">
                        Standing firm on the unchanging promises of God in every season of life.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;
                        background:linear-gradient(135deg,var(--brand-blue),var(--lilac));
                        -webkit-background-clip:text;-webkit-text-fill-color:transparent;
                        background-clip:text;line-height:1;margin-bottom:.5rem;">
                        02
                    </div>
                    <h5 class="fw-bold mb-2">Excellence</h5>
                    <p style="color:var(--text-mid);font-size:.93rem;margin:0;">
                        Doing all things with the highest standard — as unto the Lord, not men.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card">
                    <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;
                        background:linear-gradient(135deg,var(--brand-blue),var(--lilac));
                        -webkit-background-clip:text;-webkit-text-fill-color:transparent;
                        background-clip:text;line-height:1;margin-bottom:.5rem;">
                        03
                    </div>
                    <h5 class="fw-bold mb-2">Community</h5>
                    <p style="color:var(--text-mid);font-size:.93rem;margin:0;">
                        Loving, supporting, and bearing one another's burdens as the body of Christ.
                    </p>
                </div>
            </div>
        </div>

        <!-- LEADERSHIP -->
        <div style="background:linear-gradient(135deg,var(--off-white),var(--lilac-soft));
            border-radius:24px;padding:4rem;border:1px solid rgba(201,184,232,.3);">
            <div class="text-center mb-5">
                <span class="eyebrow">Leadership</span>
                <h2 class="section-title">Guided by Faith, <em>Led by the Spirit</em></h2>
                <div class="divider"></div>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-5">
                    <div class="pastor-card">
                        <img src="https://ui-avatars.com/api/?name=Edwin+Etomi&size=280&background=1A56DB&color=fff"
                             class="pastor-img" alt="Pastor Edwin Etomi">
                        <h4 style="font-family:var(--font-display);font-size:1.5rem;margin-bottom:.3rem;">
                            Pastor Edwin Etomi
                        </h4>
                        <p style="color:var(--brand-blue);font-weight:600;font-size:.9rem;
                            text-transform:uppercase;letter-spacing:1.5px;margin-bottom:1rem;">
                            Senior Pastor
                        </p>
                        <p style="color:var(--text-mid);font-size:.95rem;line-height:1.7;margin:0;">
                            Pastor Edwin is dedicated to teaching the Word of God with clarity and power,
                            leading TCLC Nigeria with a heart for people and a passion for souls.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
