@{
    ViewData["Title"] = "About Us";
}

<!-- Hero Section -->
<div class="bg-primary text-white py-5 mb-5 shadow-sm">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">Who We Are</h1>
        <p class="lead">A community of believers dedicated to faith, growth, and transformation.</p>
    </div>
</div>

<div class="container">
    <!-- Mission & Vision Section -->
    <div class="row mb-5 text-center">
        <div class="col-md-6 mb-4">
            <div class="p-4 border rounded-3 h-100 shadow-sm bg-white">
                <div class="display-6 text-primary mb-3"><i class="bi bi-compass"></i></div>
                <h2 class="fw-bold">Our Mission</h2>
                <p class="text-muted">To reach the unreached with the gospel of Jesus Christ and to empower believers to live lives of impact and purpose through the Word of God.</p>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="p-4 border rounded-3 h-100 shadow-sm bg-white">
                <div class="display-6 text-primary mb-3"><i class="bi bi-eye"></i></div>
                <h2 class="fw-bold">Our Vision</h2>
                <p class="text-muted">To build a global community of faith where lives are transformed, families are strengthened, and hope is restored to the brokenhearted.</p>
            </div>
        </div>
    </div>

    <!-- Our Values -->
    <div class="row mb-5">
        <div class="col-12 text-center mb-4">
            <h2 class="fw-bold">Core Values</h2>
            <hr class="mx-auto" style="width: 60px; height: 3px; background-color: #0d6efd;">
        </div>
        <div class="col-md-4 text-center">
            <h5 class="fw-bold">Faith</h5>
            <p class="small text-muted">Standing firm on the promises of God.</p>
        </div>
        <div class="col-md-4 text-center">
            <h5 class="fw-bold">Excellence</h5>
            <p class="small text-muted">Doing all things as unto the Lord.</p>
        </div>
        <div class="col-md-4 text-center">
            <h5 class="fw-bold">Community</h5>
            <p class="small text-muted">Loving and supporting one another.</p>
        </div>
    </div>

    <!-- Leadership Section -->
    <div class="bg-light rounded-4 p-5 mb-5 shadow-sm">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Our Leadership</h2>
            <p class="text-muted">Guided by faith and led by the Spirit.</p>
        </div>

        <div class="row justify-content-center text-center">
            <div class="col-md-4">
                <div class="mb-3">
                    <!-- Placeholder for image; replace 'src' with actual photo path -->
                    <img src="https://ui-avatars.com/api/?name=Edwin+Etomi&size=200&background=0d6efd&color=fff" class="rounded-circle border border-4 border-white shadow" alt="Pastor Edwin Etomi">
                </div>
                <h4 class="fw-bold mb-0">Pastor Edwin Etomi</h4>
                <p class="text-primary fw-bold">Senior Pastor</p>
                <p class="small text-muted px-3">Pastor Edwin is dedicated to teaching the Word of God with clarity and power, leading TCLC Nigeria with a heart for people.</p>
            </div>
        </div>
    </div>
</div>