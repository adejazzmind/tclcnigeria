@{
    ViewData["Title"] = "Our Ministries";
}

<!-- PAGE HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="eyebrow" style="color:var(--yellow);">Get Involved</span>
        <h1 class="mt-2 mb-3">Our <em>Ministries</em></h1>
        <p>There is a place for you to grow, serve, and thrive at TCLC Nigeria.</p>
    </div>
</section>

<section style="padding:5rem 0;">
    <div class="container">
        <div class="row g-4">

            <!-- Men's Ministry -->
            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=600&q=75"
                         class="ministry-card-img" alt="Men's Ministry">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-people-fill"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Men's Ministry</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">
                            Empowering men to lead with integrity, faith, and strength in their families
                            and communities.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Women of Excellence (featured) -->
            <div class="col-md-4">
                <div class="ministry-card featured" style="height:100%;">
                    <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=600&q=75"
                         class="ministry-card-img" alt="Women of Excellence">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-flower1"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);color:var(--white);">Women of Excellence</h5>
                        <p style="color:rgba(255,255,255,.78);font-size:.93rem;margin:0;">
                            Building a community of faith-filled women dedicated to prayer, mentorship,
                            and service.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Youth Rising -->
            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="https://images.unsplash.com/photo-1529390079861-591de354faf5?w=600&q=75"
                         class="ministry-card-img" alt="Youth Rising">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-person-arms-up"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Youth Rising</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">
                            Inspiring the next generation to find their purpose and passion in the
                            Word of God.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Worship & Arts -->
            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600&q=75"
                         class="ministry-card-img" alt="Worship and Arts">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-music-note-beamed"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Worship &amp; Arts</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">
                            Using music, drama, and technical arts to create an atmosphere for God's
                            presence.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Children's Church -->
            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?w=600&q=75"
                         class="ministry-card-img" alt="Children's Church">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-book"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Children's Church</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">
                            A safe, fun, and engaging environment where children learn the foundations
                            of faith.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Outreach Team -->
            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=600&q=75"
                         class="ministry-card-img" alt="Outreach Team">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-hand-thumbs-up"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Outreach Team</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">
                            Taking the love of Christ beyond our walls through community service
                            and evangelism.
                        </p>
                    </div>
                </div>
            </div>

        </div>

        <!-- CTA -->
        <div class="text-center mt-5 pt-3">
            <div style="background:linear-gradient(135deg,var(--lilac-soft),var(--yellow-soft));
                border-radius:var(--r);padding:3rem;border:1px solid rgba(201,184,232,.3);">
                <h3 style="font-family:var(--font-display);">Ready to Get Involved?</h3>
                <p style="color:var(--text-mid);margin-bottom:1.5rem;">
                    Reach out to us and we'll connect you to the right ministry for you.
                </p>
                <a asp-controller="Home" asp-action="Contact"
                   style="display:inline-block;background:var(--navy);color:var(--white);
                    border-radius:50px;padding:13px 36px;font-weight:600;
                    text-decoration:none;box-shadow:0 6px 20px rgba(7,13,46,.2);">
                    Contact Us <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</section>
