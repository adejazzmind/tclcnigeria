@{
    ViewData["Title"] = "Our Ministries";
}

<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="eyebrow" style="color:var(--yellow);">Get Involved</span>
        <h1 class="mt-2 mb-3">Our <em>Ministries</em></h1>
        <p>There is a place for you to grow, serve, and thrive at TCLC Nigeria.</p>
    </div>
</section>

<section style="padding:5rem 0;">
    <div class="container">
        <div class="row g-4">

            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="data:image/jpeg;base64," class="ministry-card-img" alt="Men of Honour">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-people-fill"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Men of Honour</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">Empowering men to lead with integrity, faith, and strength in their families and communities.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="ministry-card featured" style="height:100%;">
                    <img src="data:image/jpeg;base64," class="ministry-card-img" alt="Women of Glory">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-flower1"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);color:var(--white);">Women of Glory</h5>
                        <p style="color:rgba(255,255,255,.78);font-size:.93rem;margin:0;">Building a community of faith-filled women dedicated to prayer, mentorship, and service.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="data:image/jpeg;base64," class="ministry-card-img" alt="Youth Rising">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-person-arms-up"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Youth Rising</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">Inspiring the next generation to find their purpose and passion in the Word of God.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="data:image/jpeg;base64," class="ministry-card-img" alt="Choir - Champion Voices">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-music-note-beamed"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Choir &mdash; Champion Voices</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">Lifting the name of God through anointed praise and worship, creating an atmosphere for His glorious presence.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="ministry-card featured" style="height:100%;">
                    <img src="https://images.unsplash.com/photo-1503095396549-807759245b35?w=600&q=75" class="ministry-card-img" alt="Drama - The Royal Priesthood">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-mask"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);color:var(--white);">Drama &mdash; The Royal Priesthood</h5>
                        <p style="color:rgba(255,255,255,.78);font-size:.93rem;margin:0;">Communicating the Gospel through powerful dramatic arts, touching hearts and transforming lives for God&rsquo;s Kingdom.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="data:image/jpeg;base64," class="ministry-card-img" alt="The Kingdom Heritage">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-book"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">The Kingdom Heritage</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">A safe, fun, and engaging environment where children learn the foundations of faith and grow as Kingdom heirs.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="data:image/jpeg;base64," class="ministry-card-img" alt="Outreach Team">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-hand-thumbs-up"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Outreach Team</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">Taking the love of Christ beyond our walls through community service and evangelism.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="ministry-card featured" style="height:100%;">
                    <img src="data:image/jpeg;base64," class="ministry-card-img" alt="Care and Hospitality Unit">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-heart-fill"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);color:var(--white);">Care &amp; Hospitality Unit</h5>
                        <p style="color:rgba(255,255,255,.78);font-size:.93rem;margin:0;">Extending the warmth and love of God to every member and visitor, ensuring everyone feels welcomed, valued, and cared for.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="ministry-card">
                    <img src="data:image/jpeg;base64," class="ministry-card-img" alt="Greeters Unit">
                    <div class="ministry-card-body">
                        <div class="ministry-icon"><i class="bi bi-door-open"></i></div>
                        <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">Greeters Unit</h5>
                        <p style="color:var(--text-mid);font-size:.93rem;margin:0;">Our dedicated team who warmly welcome both new and returning members to church, ensuring every person feels seen, loved, and at home from the moment they walk through our doors.</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="text-center mt-5 pt-3">
            <div style="background:linear-gradient(135deg,var(--lilac-soft),var(--yellow-soft));border-radius:var(--r);padding:3rem;border:1px solid rgba(201,184,232,.3);">
                <h3 style="font-family:var(--font-display);">Ready to Get Involved?</h3>
                <p style="color:var(--text-mid);margin-bottom:1.5rem;">Reach out to us and we will connect you to the right ministry for you.</p>
                <a asp-controller="Home" asp-action="Contact" style="display:inline-block;background:var(--navy);color:var(--white);border-radius:50px;padding:13px 36px;font-weight:600;text-decoration:none;box-shadow:0 6px 20px rgba(7,13,46,.2);">
                    Contact Us <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</section>



