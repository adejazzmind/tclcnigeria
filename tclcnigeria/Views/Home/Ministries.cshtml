@{
    ViewData["Title"] = "Our Ministries";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary display-4">Our Ministries</h1>
        <p class="lead text-muted">There is a place for you to grow and serve at TCLC Nigeria.</p>
        <hr class="mx-auto" style="width: 100px; height: 3px; background-color: #007bff;">
    </div>

    <div class="row g-4">
        <!-- Ministry Card 1 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body text-center p-4">
                    <div class="display-5 text-primary mb-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h4 class="card-title fw-bold">Men's Ministry</h4>
                    <p class="card-text text-muted">Empowering men to lead with integrity, faith, and strength in their families and communities.</p>
                </div>
            </div>
        </div>

        <!-- Ministry Card 2 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-3 text-white bg-primary">
                <div class="card-body text-center p-4">
                    <div class="display-5 mb-3">
                        <i class="bi bi-flower1"></i>
                    </div>
                    <h4 class="card-title fw-bold">Women of Excellence</h4>
                    <p class="card-text">Building a community of faith-filled women dedicated to prayer, mentorship, and service.</p>
                </div>
            </div>
        </div>

        <!-- Ministry Card 3 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body text-center p-4">
                    <div class="display-5 text-primary mb-3">
                        <i class="bi bi-person-arms-up"></i>
                    </div>
                    <h4 class="card-title fw-bold">Youth Rising</h4>
                    <p class="card-text text-muted">Inspiring the next generation to find their purpose and passion in the Word of God.</p>
                </div>
            </div>
        </div>

        <!-- Ministry Card 4 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body text-center p-4">
                    <div class="display-5 text-primary mb-3">
                        <i class="bi bi-music-note-beamed"></i>
                    </div>
                    <h4 class="card-title fw-bold">Worship & Arts</h4>
                    <p class="card-text text-muted">Using our talents in music, drama, and technical arts to create an atmosphere for God's presence.</p>
                </div>
            </div>
        </div>

        <!-- Ministry Card 5 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body text-center p-4">
                    <div class="display-5 text-primary mb-3">
                        <i class="bi bi-book"></i>
                    </div>
                    <h4 class="card-title fw-bold">Children's Church</h4>
                    <p class="card-text text-muted">A safe, fun, and engaging environment where children learn the foundations of faith.</p>
                </div>
            </div>
        </div>

        <!-- Ministry Card 6 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body text-center p-4">
                    <div class="display-5 text-primary mb-3">
                        <i class="bi bi-hand-thumbs-up"></i>
                    </div>
                    <h4 class="card-title fw-bold">Outreach Team</h4>
                    <p class="card-text text-muted">Taking the love of Christ beyond our walls through community service and evangelism.</p>
                </div>
            </div>
        </div>
    </div>
</div>