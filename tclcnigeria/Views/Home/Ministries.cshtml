@{
    ViewData["Title"] = "Our Ministries";
}

<!-- PAGE HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="badge bg-light text-dark mb-3 px-3 py-2 rounded-pill">Get Involved</span>
        <h1 class="mt-2">Our <em>Ministries</em></h1>
        <p class="lead">There is a place for you to grow and serve at TCLC Nigeria.</p>
    </div>
</section>

<section class="py-section bg-light">
    <div class="container">
        <div class="row g-4">
            <!-- Men's Ministry -->
            <div class="col-md-4">
                <div class="ministry-card"
                     style="background: linear-gradient(rgba(10,17,40,0.85), rgba(10,17,40,0.85)),
                    url('https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=600&q=80') center/cover;">
                    <div class="ministry-icon bg-icon-gold mx-auto"><i class="bi bi-people-fill"></i></div>
                    <h4 class="text-white">Men's Fellowship</h4>
                    <p class="mb-0 text-white-50">Empowering men to lead with integrity, faith, and strength.</p>
                </div>
            </div>

            <!-- Women's Ministry -->
            <div class="col-md-4">
                <div class="ministry-card"
                     style="background: linear-gradient(rgba(124, 58, 237, 0.85), rgba(124, 58, 237, 0.85)),
                    url('https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=600&q=80') center/cover;">
                    <div class="ministry-icon bg-icon-gold mx-auto"><i class="bi bi-flower1"></i></div>
                    <h4 class="text-white">Women's Ministry</h4>
                    <p class="mb-0 text-white-50">Building a community of faith-filled women dedicated to prayer.</p>
                </div>
            </div>

            <!-- Youth Ministry -->
            <div class="col-md-4">
                <div class="ministry-card"
                     style="background: linear-gradient(rgba(249, 115, 22, 0.85), rgba(249, 115, 22, 0.85)),
                    url('https://images.unsplash.com/photo-1523580494863-6f3031224c94?w=600&q=80') center/cover;">
                    <div class="ministry-icon bg-icon-navy mx-auto"><i class="bi bi-person-arms-up"></i></div>
                    <h4 class="text-white">Youth Ministry</h4>
                    <p class="mb-0 text-white-50">Inspiring the next generation to find their purpose in God's Word.</p>
                </div>
            </div>

            <!-- Choir & Arts -->
            <div class="col-md-4">
                <div class="ministry-card"
                     style="background: linear-gradient(rgba(16, 185, 129, 0.85), rgba(16, 185, 129, 0.85)),
                    url('https://images.unsplash.com/photo-1516280440614-37939bbacd81?w=600&q=80') center/cover;">
                    <div class="ministry-icon bg-icon-navy mx-auto"><i class="bi bi-music-note-beamed"></i></div>
                    <h4 class="text-white">Choir & Worship</h4>
                    <p class="mb-0 text-white-50">Using music to create an atmosphere for God's presence.</p>
                </div>
            </div>

            <!-- Children's Church -->
            <div class="col-md-4">
                <div class="ministry-card"
                     style="background: linear-gradient(rgba(59, 130, 246, 0.85), rgba(59, 130, 246, 0.85)),
                    url('https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=600&q=80') center/cover;">
                    <div class="ministry-icon bg-icon-gold mx-auto"><i class="bi bi-emoji-smile"></i></div>
                    <h4 class="text-white">Children's Church</h4>
                    <p class="mb-0 text-white-50">A safe, fun environment where children learn foundations of faith.</p>
                </div>
            </div>

            <!-- Evangelism -->
            <div class="col-md-4">
                <div class="ministry-card"
                     style="background: linear-gradient(rgba(251, 146, 60, 0.85), rgba(251, 146, 60, 0.85)),
                    url('https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=600&q=80') center/cover;">
                    <div class="ministry-icon bg-icon-navy mx-auto"><i class="bi bi-megaphone"></i></div>
                    <h4 class="text-white">Evangelism</h4>
                    <p class="mb-0 text-white-50">Reaching the lost with the gospel through community service.</p>
                </div>
            </div>

            <!-- Prayer Ministry -->
            <div class="col-md-4">
                <div class="ministry-card" style="background: var(--navy);">
                    <div class="ministry-icon bg-icon-purple mx-auto"><i class="bi bi-heart"></i></div>
                    <h4 class="text-white">Prayer Ministry</h4>
                    <p class="mb-0 text-white-50">Interceding for the church, the nation, and the world.</p>
                </div>
            </div>

            <!-- Ushering -->
            <div class="col-md-4">
                <div class="ministry-card" style="background: var(--navy);">
                    <div class="ministry-icon bg-icon-gold mx-auto"><i class="bi bi-door-open"></i></div>
                    <h4 class="text-white">Ushering</h4>
                    <p class="mb-0 text-white-50">Welcoming visitors with warmth and excellence.</p>
                </div>
            </div>

            <!-- Media -->
            <div class="col-md-4">
                <div class="ministry-card" style="background: var(--navy);">
                    <div class="ministry-icon bg-icon-green mx-auto"><i class="bi bi-camera-video"></i></div>
                    <h4 class="text-white">Media & Tech</h4>
                    <p class="mb-0 text-white-50">Spreading the gospel through digital platforms.</p>
                </div>
            </div>

        </div>
    </div>
</section>