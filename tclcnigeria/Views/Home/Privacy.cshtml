@{
    ViewData["Title"] = "Privacy Policy";
}

<!-- Page Header -->
<section class="hero-section py-5">
    <div class="container">
        <h1>Privacy Policy</h1>
        <p class="lead text-light mb-0">Your trust matters to us at TCLC Nigeria.</p>
    </div>
</section>

<!-- Main Content -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <!-- Last Updated Badge -->
            <div class="d-flex align-items-center mb-4">
                <span class="badge bg-light text-dark border px-3 py-2">
                    <i class="bi bi-calendar-event"></i>
                    Last Updated: @DateTime.Now.ToString("MMMM yyyy")
                </span>
            </div>

            <!-- Introduction -->
            <div class="mb-5">
                <p class="lead text-muted">
                    The City Of The Lord Church Nigeria (TCLC Nigeria) &mdash; <em>"we", "us", or "our"</em> &mdash;
                    respects your privacy. This Privacy Policy explains how we collect, use,
                    and protect your information when you visit our website, use our mobile app,
                    or interact with any of our online services.
                </p>
            </div>

            <!-- Section 1: Information We Collect -->
            <section class="mb-5">
                <h2 class="text-primary fw-bold">
                    <i class="bi bi-info-circle"></i> Information We Collect
                </h2>
                <p class="text-muted">Depending on how you use our site, we may collect:</p>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>Contact form:</strong> your full name, email address, and message.</li>
                    <li class="list-group-item"><strong>Prayer requests:</strong> your name, email address (optional), and the content of your request.</li>
                    <li class="list-group-item"><strong>Lord's City Bible Institute applications:</strong> your name, email, phone number, address, and any testimony you share.</li>
                    <li class="list-group-item"><strong>The Workforce (C.T.G.) enrollment:</strong> your name, email, phone number, and department of interest.</li>
                    <li class="list-group-item"><strong>C.A. &amp; Exams:</strong> your name, email, and exam results, used to verify eligibility and record scores.</li>
                    <li class="list-group-item"><strong>Staff accounts:</strong> if you are approved staff, your email address and encrypted login credentials.</li>
                    <li class="list-group-item"><strong>AI Assistant conversations:</strong> questions you ask our AI chat assistant are processed to generate a response but are not permanently stored by us.</li>
                </ul>
            </section>

            <!-- Section 2: How We Use Your Information -->
            <section class="mb-5">
                <h2 class="text-primary fw-bold">
                    <i class="bi bi-shield-check"></i> How We Use Your Information
                </h2>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">To respond to your messages, prayer requests, and inquiries.</li>
                    <li class="list-group-item">To process and review Bible Institute applications and Workforce enrollments.</li>
                    <li class="list-group-item">To verify eligibility for, and record results of, C.A. &amp; Exams.</li>
                    <li class="list-group-item">To provide instant answers to common questions via our AI assistant.</li>
                    <li class="list-group-item">To send updates about our services and events, where applicable.</li>
                    <li class="list-group-item">To improve our services and ministry to you.</li>
                </ul>
            </section>

            <!-- Section 3: Third-Party Services -->
            <section class="mb-5">
                <h2 class="text-primary fw-bold">
                    <i class="bi bi-diagram-3"></i> Third-Party Services We Use
                </h2>
                <p class="text-muted">
                    To operate our website and app, we rely on a small number of trusted third-party providers,
                    who process limited data strictly to deliver their service to us:
                </p>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>Google Gemini:</strong> powers our AI chat assistant.</li>
                    <li class="list-group-item"><strong>Brevo:</strong> delivers transactional emails (e.g. prayer request confirmations).</li>
                    <li class="list-group-item"><strong>Paystack:</strong> processes online giving securely; we do not store your card details.</li>
                    <li class="list-group-item"><strong>YouTube, Facebook &amp; Instagram:</strong> embedded content on our Gallery and Watch Live pages, governed by their own privacy policies.</li>
                    <li class="list-group-item"><strong>Render &amp; Neon:</strong> host our website, app, and database infrastructure.</li>
                </ul>
            </section>

            <!-- Section 4: Cookies -->
            <section class="mb-5">
                <h2 class="text-primary fw-bold">
                    <i class="bi bi-cookie"></i> Cookies
                </h2>
                <p class="text-muted">
                    We use a small, essential authentication cookie so approved staff members can stay
                    securely logged in to admin areas. We do not use tracking or advertising cookies.
                </p>
            </section>

            <!-- Section 5: Information Sharing -->
            <section class="mb-5">
                <h2 class="text-primary fw-bold">
                    <i class="bi bi-lock"></i> Information Sharing
                </h2>
                <p class="text-muted">
                    We <strong>do not sell, trade, or rent</strong> your personal information to third parties.
                    Data is only shared with the trusted service providers listed above, strictly as needed
                    to operate our website and app.
                </p>
            </section>

            <!-- Section 6: Your Rights -->
            <section class="mb-5">
                <h2 class="text-primary fw-bold">
                    <i class="bi bi-person-check"></i> Your Rights
                </h2>
                <p class="text-muted">You have the right to:</p>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Request access to your personal data.</li>
                    <li class="list-group-item">Request correction of inaccurate information.</li>
                    <li class="list-group-item">Request deletion of your information from our records.</li>
                </ul>
            </section>

            <!-- Section 7: Children's Privacy -->
            <section class="mb-5">
                <h2 class="text-primary fw-bold">
                    <i class="bi bi-shield"></i> Children's Privacy
                </h2>
                <p class="text-muted">
                    Our website and app are not directed at children under 13, and we do not knowingly
                    collect personal information from children under 13 without parental consent.
                </p>
            </section>

            <!-- Section 8: Contact -->
            <section class="mb-5">
                <h2 class="text-primary fw-bold">
                    <i class="bi bi-envelope"></i> Contact Us
                </h2>
                <p class="text-muted">
                    If you have any questions about this Privacy Policy, please reach out:
                </p>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold">Email</small>
                                <p class="mb-0 fw-semibold">tclcnigeria@gmail.com</p>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold">Phone</small>
                                <p class="mb-0 fw-semibold">+234 808 883 4964</p>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted text-uppercase fw-bold">Address</small>
                                <p class="mb-0 fw-semibold small">
                                    25, Kudirat Soule Str, Off Coker Str,<br>
                                    College, Ifako/Ogba, Lagos.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Call to Action -->
            <div class="text-center mt-5 pt-3 border-top">
                <p class="text-muted mb-3">Have a question or need assistance?</p>
                <a asp-controller="Home" asp-action="Contact" class="btn-church-cta">
                    <i class="bi bi-chat-dots"></i> Contact Us
                </a>
            </div>

        </div>
    </div>
</div>
