@model tclcnigeria.Models.ContactForm

@{
    ViewData["Title"] = "Contact Us";
}

<!-- PAGE HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="eyebrow" style="color:var(--yellow);">Reach Out</span>
        <h1 class="mt-2 mb-3">We'd Love to <em>Hear From You</em></h1>
        <p>Have a question or want to visit? Send us a message and we'll respond shortly.</p>
    </div>
</section>

<section style="padding:5rem 0;">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div style="background:linear-gradient(135deg,#d1fae5,#a7f3d0);
                border:1px solid #6ee7b7;border-radius:var(--r);
                color:#065f46;padding:1.2rem 1.5rem;margin-bottom:2rem;
                display:flex;align-items:center;gap:1rem;">
                <span style="font-size:1.5rem;">&#9989;</span>
                <span>@TempData["Success"]</span>
            </div>
        }

        <div class="row g-5">
            <!-- FORM -->
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h4 style="font-family:var(--font-display);margin-bottom:1.8rem;">
                        Send Us a Message
                    </h4>
                    <form asp-action="Contact" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="Name" class="form-label"
                                       style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                    Full Name
                                </label>
                                <input asp-for="Name" class="form-control" placeholder="Your full name" />
                                <span asp-validation-for="Name" class="text-danger" style="font-size:.82rem;"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Email" class="form-label"
                                       style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                    Email Address
                                </label>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger" style="font-size:.82rem;"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subject" class="form-label"
                                   style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                Subject
                            </label>
                            <input asp-for="Subject" class="form-control" placeholder="What is this about?" />
                            <span asp-validation-for="Subject" class="text-danger" style="font-size:.82rem;"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Message" class="form-label"
                                   style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                Message
                            </label>
                            <textarea asp-for="Message" class="form-control" rows="5"
                                      placeholder="Write your message here..."></textarea>
                            <span asp-validation-for="Message" class="text-danger" style="font-size:.82rem;"></span>
                        </div>

                        <button type="submit" class="btn-submit">
                            <i class="bi bi-send me-2"></i>Send Message
                        </button>
                    </form>
                </div>
            </div>

            <!-- INFO BOX -->
            <div class="col-lg-5">
                <div class="info-box">
                    <h4>Get In Touch</h4>

                    <div class="info-row">
                        <div class="info-icon"><i class="bi bi-geo-alt-fill"></i></div>
                        <div>
                            <p class="fw-bold mb-0" style="color:var(--white);">Our Address</p>
                            <p style="line-height:1.7;">
                                25, Kudirat Soule Street,<br>
                                off Coker Street, Orimolade Bus Stop,<br>
                                College Road, Ifako, Ogba, Lagos.
                            </p>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-icon"><i class="bi bi-telephone-fill"></i></div>
                        <div>
                            <p class="fw-bold mb-0" style="color:var(--white);">Phone</p>
                            <p>
                                <a href="tel:07082768005"
                                   style="color:rgba(255,255,255,.8);text-decoration:none;"
                                   onmouseover="this.style.color='var(--yellow)'"
                                   onmouseout="this.style.color='rgba(255,255,255,.8)'">
                                    07082768005
                                </a>
                            </p>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-icon"><i class="bi bi-envelope-fill"></i></div>
                        <div>
                            <p class="fw-bold mb-0" style="color:var(--white);">Email</p>
                            <p>
                                <a href="mailto:info@tclcnigeria.org"
                                   style="color:rgba(255,255,255,.8);text-decoration:none;"
                                   onmouseover="this.style.color='var(--yellow)'"
                                   onmouseout="this.style.color='rgba(255,255,255,.8)'">
                                    info@tclcnigeria.org
                                </a>
                            </p>
                        </div>
                    </div>

                    <!-- SERVICE TIMES -->
                    <div class="info-row" style="align-items:flex-start;">
                        <div class="info-icon" style="margin-top:4px;"><i class="bi bi-clock-fill"></i></div>
                        <div>
                            <p class="fw-bold mb-2" style="color:var(--white);">Service Times</p>

                            <!-- Sundays -->
                            <p class="fw-bold mb-1" style="color:var(--yellow);font-size:.85rem;
                            text-transform:uppercase;letter-spacing:1px;">Sundays</p>
                            <div style="border-left:2px solid rgba(245,200,66,.4);padding-left:.8rem;margin-bottom:1rem;">
                                <p style="margin:0 0 .3rem;">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;color:var(--yellow);"></i>
                                    1st Service &mdash; <strong style="color:var(--white);">7:30 AM</strong>
                                </p>
                                <p style="margin:0 0 .3rem;">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;color:var(--yellow);"></i>
                                    Sunday School Class &mdash; <strong style="color:var(--white);">9:00 &ndash; 9:50 AM</strong>
                                </p>
                                <p style="margin:0;">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;color:var(--yellow);"></i>
                                    2nd Service &mdash; <strong style="color:var(--white);">10:00 AM</strong>
                                </p>
                            </div>

                            <!-- Wednesday -->
                            <p class="fw-bold mb-1" style="color:var(--yellow);font-size:.85rem;
                            text-transform:uppercase;letter-spacing:1px;">Wednesday</p>
                            <div style="border-left:2px solid rgba(245,200,66,.4);padding-left:.8rem;margin-bottom:1rem;">
                                <p style="margin:0;">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;color:var(--yellow);"></i>
                                    Bible Study &mdash; <strong style="color:var(--white);">6:00 PM</strong>
                                </p>
                            </div>

                            <!-- Every Fortnight Tuesday -->
                            <p class="fw-bold mb-1" style="color:var(--yellow);font-size:.85rem;
                            text-transform:uppercase;letter-spacing:1px;">Every Fortnight &mdash; Tuesday</p>
                            <div style="border-left:2px solid rgba(245,200,66,.4);padding-left:.8rem;margin-bottom:1rem;">
                                <p style="margin:0;">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;color:var(--yellow);"></i>
                                    Holy Ghost Miracle Hour Service &mdash; <strong style="color:var(--white);">7:00 AM</strong>
                                </p>
                            </div>

                            <!-- Lord's Night -->
                            <p class="fw-bold mb-1" style="color:var(--yellow);font-size:.85rem;
                            text-transform:uppercase;letter-spacing:1px;">First Friday of Every Month</p>
                            <div style="border-left:2px solid rgba(245,200,66,.4);padding-left:.8rem;">
                                <p style="margin:0;">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;color:var(--yellow);"></i>
                                    Lord's Night
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Social -->
                    <div style="border-top:1px solid rgba(255,255,255,.1);padding-top:1.2rem;margin-top:1rem;">
                        <p class="fw-bold mb-2" style="color:var(--white);font-size:.88rem;">Follow Us</p>
                        <div class="d-flex gap-2">
                            <a href="https://www.youtube.com/@@tclcnigeria" target="_blank"
                               style="width:36px;height:36px;border-radius:50%;
                                background:rgba(255,255,255,.1);display:flex;
                                align-items:center;justify-content:center;
                                color:rgba(255,255,255,.7);text-decoration:none;transition:all .2s;"
                               onmouseover="this.style.background='#FF0000';this.style.color='#fff'"
                               onmouseout="this.style.background='rgba(255,255,255,.1)';this.style.color='rgba(255,255,255,.7)'">
                                <i class="bi bi-youtube"></i>
                            </a>
                            <a href="https://instagram.com/tclcnigeria" target="_blank"
                               style="width:36px;height:36px;border-radius:50%;
                                background:rgba(255,255,255,.1);display:flex;
                                align-items:center;justify-content:center;
                                color:rgba(255,255,255,.7);text-decoration:none;transition:all .2s;"
                               onmouseover="this.style.background='#E1306C';this.style.color='#fff'"
                               onmouseout="this.style.background='rgba(255,255,255,.1)';this.style.color='rgba(255,255,255,.7)'">
                                <i class="bi bi-instagram"></i>
                            </a>
                            <a href="https://facebook.com/thecityofthelordchurch" target="_blank"
                               style="width:36px;height:36px;border-radius:50%;
                                background:rgba(255,255,255,.1);display:flex;
                                align-items:center;justify-content:center;
                                color:rgba(255,255,255,.7);text-decoration:none;transition:all .2s;"
                               onmouseover="this.style.background='#1877F2';this.style.color='#fff'"
                               onmouseout="this.style.background='rgba(255,255,255,.1)';this.style.color='rgba(255,255,255,.7)'">
                                <i class="bi bi-facebook"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Map -->
                    <div style="border-radius:12px;overflow:hidden;margin-top:1.2rem;">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3963.3!2d3.34!3d6.62!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNsKwMzcnMTIuMCJOIDPCsDIwJzI0LjAiRQ!5e0!3m2!1sen!2sng!4v1641000000000"
                                width="100%" height="180" style="border:0;"
                                allowfullscreen loading="lazy"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
