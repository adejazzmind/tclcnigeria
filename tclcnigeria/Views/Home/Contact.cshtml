@model tclcnigeria.Models.ContactForm

@{
    ViewData["Title"] = "Contact Us";
}

<!-- CONTACT HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="badge bg-light text-dark mb-3 px-3 py-2 rounded-pill">Get in Touch</span>
        <h1 class="mt-2">Contact <em>Us</em></h1>
        <p class="lead">We'd love to hear from you. Reach out or visit us today.</p>
    </div>
</section>

<div class="container py-5">
    <div class="row g-5">
        <!-- Contact Form -->
        <div class="col-lg-6">
            <div class="bg-white p-4 shadow-sm rounded h-100" style="border: 1px solid var(--border-gray);">
                <h4 class="fw-bold mb-4 text-navy"><i class="bi bi-envelope me-2"></i> Send us a Message</h4>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Contact" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-bold text-uppercase text-muted-custom"></label>
                        <input asp-for="Name" class="form-control form-control-lg bg-light border-0" placeholder="Your Name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold text-uppercase text-muted-custom"></label>
                        <input asp-for="Email" class="form-control form-control-lg bg-light border-0" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label small fw-bold text-uppercase text-muted-custom"></label>
                        <input asp-for="Subject" class="form-control form-control-lg bg-light border-0" />
                        <span asp-validation-for="Subject" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Message" class="form-label small fw-bold text-uppercase text-muted-custom"></label>
                        <textarea asp-for="Message" class="form-control form-control-lg bg-light border-0" rows="4"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-give w-100 btn-lg">
                        <i class="bi bi-send me-2"></i> Send Message
                    </button>
                </form>
            </div>
        </div>

        <!-- Contact Info & Map -->
        <div class="col-lg-6">
            <div class="h-100 p-4 bg-navy text-white rounded shadow-lg">
                <h4 class="fw-bold mb-4 text-gold"><i class="bi bi-geo-alt me-2"></i> Visit Us</h4>

                <div class="mb-4">
                    <h6 class="fw-bold text-white mb-2">Address:</h6>
                    <p class="mb-0 text-white-50">
                        25, Kudirat Soule Street, Off Coker Street,<br>
                        College, Ifako/Ogba, Lagos, Nigeria.
                    </p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-white mb-2"><i class="bi bi-telephone me-2"></i> Phone:</h6>
                    <p class="mb-0 text-white-50">+234 808 883 4964</p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-white mb-2"><i class="bi bi-envelope me-2"></i> Email:</h6>
                    <p class="mb-0 text-white-50">tclcnigeria@gmail.com</p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-white mb-3">Connect With Us:</h6>
                    <a href="https://instagram.com/tclcnigeria" target="_blank" class="social-icon"><i class="bi bi-instagram"></i></a>
                    <a href="https://facebook.com/thecityofthelordchurch" target="_blank" class="social-icon"><i class="bi bi-facebook"></i></a>
                    <a href="https://www.youtube.com/@@tclcnigeria" target="_blank" class="social-icon"><i class="bi bi-youtube"></i></a>
                </div>

                <div class="ratio ratio-16x9 rounded overflow-hidden border border-secondary">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3963.123!2d3.3!3d6.6!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sIfako-Ijaiye%2C%20Lagos!5e0!3m2!1sen!2sng!4v1641000000000"
                            style="border:0;" allowfullscreen="" loading="lazy">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>