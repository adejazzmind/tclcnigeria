@{
    ViewData["Title"] = "Gallery";
}
<!-- PAGE HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="eyebrow" style="color:var(--yellow);">Moments With Us</span>
        <h1 class="mt-2 mb-3">Our <em>Gallery</em></h1>
        <p>A look at life at TCLC Nigeria &mdash; straight from our Instagram and Facebook pages.</p>
    </div>
</section>

<section style="padding:5rem 0;">
    <div class="container">
        <div class="row g-5">

            <!-- FACEBOOK -->
            <div class="col-lg-6">
                <span class="eyebrow">Follow Us</span>
                <h2 class="mt-2 mb-3" style="font-family:var(--font-display);">On Facebook</h2>
                <p style="color:var(--text-mid);margin-bottom:1.5rem;">
                    <a href="https://web.facebook.com/thecityofthelordchurch" target="_blank" rel="noopener"
                       style="color:var(--brand-blue);font-weight:600;text-decoration:none;">
                        The City of The Lord Church <i class="bi bi-box-arrow-up-right ms-1"></i>
                    </a>
                </p>
                <div style="border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid rgba(201,184,232,.2);">
                    <iframe
                        src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fweb.facebook.com%2Fthecityofthelordchurch&tabs=timeline&width=500&height=700&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true"
                        width="100%" height="700" style="border:none;overflow:hidden;display:block;"
                        scrolling="no" frameborder="0"
                        allowfullscreen="true"
                        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
                    </iframe>
                </div>
            </div>

            <!-- INSTAGRAM -->
            <div class="col-lg-6">
                <span class="eyebrow">Follow Us</span>
                <h2 class="mt-2 mb-3" style="font-family:var(--font-display);">On Instagram</h2>
                <p style="color:var(--text-mid);margin-bottom:1.5rem;">
                    <a href="https://www.instagram.com/tclcnigeria" target="_blank" rel="noopener"
                       style="color:var(--brand-blue);font-weight:600;text-decoration:none;">
                        @@tclcnigeria <i class="bi bi-box-arrow-up-right ms-1"></i>
                    </a>
                </p>
                <div style="border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid rgba(201,184,232,.2);min-height:700px;display:flex;align-items:center;justify-content:center;background:#f7f8fa;">
                    <!--
                        INSTAGRAM WIDGET PLACEHOLDER
                        Replace this comment block with your SnapWidget (or Elfsight) embed code
                        once you've created it at snapwidget.com.
                    -->
                    <p style="color:var(--text-light);text-align:center;padding:2rem;">
                        Instagram feed coming soon.<br>
                        <a href="https://www.instagram.com/tclcnigeria" target="_blank" rel="noopener" style="color:var(--brand-blue);">
                            Visit our Instagram directly &rarr;
                        </a>
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>
