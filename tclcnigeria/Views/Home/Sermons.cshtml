@model IEnumerable<tclcnigeria.Models.Sermon>

@{
    ViewData["Title"] = "Sermon Archive";
}

<div class="container py-5">
    <h1 class="text-center mb-5 fw-bold">Recent Sermons</h1>

    <div class="row">
        @foreach (var sermon in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="ratio ratio-16x9">
                        <iframe src="@sermon.VideoUrl" title="@sermon.Title" allowfullscreen></iframe>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@sermon.Title</h5>
                        <p class="text-muted mb-1"><strong>Speaker:</strong> @sermon.Speaker</p>
                        <p class="text-muted mb-2"><strong>Date:</strong> @sermon.DatePreached.ToString("MMM dd, yyyy")</p>
                        <p class="card-text">@sermon.Description</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>