@model IEnumerable<tclcnigeria.Models.Sermon>

@{
    ViewData["Title"] = "Sermon Archive";
}

<!-- PAGE HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="badge bg-warning text-dark mb-3 px-3 py-2 rounded-pill">The Word of God</span>
        <h1 class="mt-2">Sermon <em>Archive</em></h1>
        <p>Watch, listen, and grow through the teachings of TCLC Nigeria.</p>
    </div>
</section>

<section style="padding:5rem 0;">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div style="width:80px;height:80px;border-radius:50%;background:var(--lilac-soft, #ede5f8);
                    display:flex;align-items:center;justify-content:center;
                    margin:0 auto 1.5rem;font-size:2rem;color:var(--brand-blue);">
                    <i class="bi bi-camera-video"></i>
                </div>
                <h4 style="font-family:var(--font-display);">No sermons yet</h4>
                <p style="color:var(--text-mid);">Check back soon — new sermons are added regularly.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var sermon in Model)
                {
                    <div class="col-md-6">
                        <div class="sermon-card">
                            @if (!string.IsNullOrEmpty(sermon.VideoUrl))
                            {
                                <div class="ratio ratio-16x9">
                                    <iframe src="@sermon.VideoUrl" title="@sermon.Title"
                                            allowfullscreen style="border:0;"></iframe>
                                </div>
                            }
                            else
                            {
                                <!-- Placeholder Image if no video URL -->
                                <img src="https://images.unsplash.com/photo-1478147427282-58a87a120781?w=600&q=80"
                                     class="img-fluid w-100" alt="Sermon thumbnail" style="height: 250px; object-fit: cover;" />
                            }

                            <div class="sermon-card-body">
                                @if (!string.IsNullOrEmpty(sermon.SeriesName))
                                {
                                    <span class="sermon-tag">@sermon.SeriesName</span>
                                }
                                <h5 class="fw-bold mb-2" style="font-family:var(--font-display);">
                                    @sermon.Title
                                </h5>
                                <div class="d-flex gap-3 mb-2" style="color:var(--text-light);font-size:.85rem;">
                                    <span><i class="bi bi-person me-1"></i>@sermon.Speaker</span>
                                    <span><i class="bi bi-calendar3 me-1"></i>@sermon.DatePreached.ToString("MMM dd, yyyy")</span>
                                </div>
                                <p style="color:var(--text-mid);font-size:.93rem;margin:0;">
                                    @sermon.Description
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>