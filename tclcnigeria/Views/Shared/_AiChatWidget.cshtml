<div id="tclc-ai-widget">
    <button id="tclc-ai-toggle" aria-label="Ask TCLC a question">
        <span id="tclc-ai-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 5.94 2 10.8c0 2.76 1.44 5.22 3.7 6.84-.13 1.13-.55 2.55-1.55 4.06a.5.5 0 0 0 .58.75c2.1-.62 3.72-1.55 4.77-2.3.8.13 1.63.2 2.5.2 5.52 0 10-3.94 10-8.8S17.52 2 12 2z" fill="#fff"/></svg></span>
    </button>

    <div id="tclc-ai-panel" class="tclc-ai-hidden">
        <div id="tclc-ai-header">
            <span>Ask TCLC</span>
            <button id="tclc-ai-close" aria-label="Close chat">&times;</button>
        </div>
        <div id="tclc-ai-messages">
            <div class="tclc-ai-msg tclc-ai-msg-bot">
                Hi! I'm the TCLC assistant. Ask me about service times, ministries, upcoming events, or how to give.
            </div>
        </div>
        <form id="tclc-ai-form">
            <input id="tclc-ai-input" type="text" placeholder="Type your question..." autocomplete="off" />
            <button type="submit" id="tclc-ai-send" aria-label="Send">?</button>
        </form>
    </div>
</div>

<style>
    #tclc-ai-widget {
        position: fixed;
        bottom: 76px; right: 24px; z-index: 9999; font-family: var(--font-body, 'DM Sans', sans-serif); }
    #tclc-ai-toggle { width: 60px; height: 60px; border-radius: 50%; background: var(--navy, #1a2a4a); color: #fff; border: none; font-size: 26px; cursor: pointer; box-shadow: 0 6px 18px rgba(0,0,0,0.25); transition: transform 0.15s ease; }
    #tclc-ai-toggle:hover { transform: scale(1.06); }
    #tclc-ai-panel { position: absolute; bottom: 74px; right: 0; width: 340px; max-width: 90vw; height: 460px; max-height: 70vh; background: #fff; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); display: flex; flex-direction: column; overflow: hidden; }
    #tclc-ai-panel.tclc-ai-hidden { display: none; }
    #tclc-ai-header { background: var(--navy, #1a2a4a); color: #fff; padding: 14px 16px; font-family: var(--font-display, 'Playfair Display', serif); font-weight: 600; display: flex; justify-content: space-between; align-items: center; }
    #tclc-ai-close { background: none; border: none; color: #fff; font-size: 22px; cursor: pointer; line-height: 1; }
    #tclc-ai-messages { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; background: #f7f8fa; }
    .tclc-ai-msg { padding: 10px 14px; border-radius: 14px; max-width: 85%; font-size: 14px; line-height: 1.45; white-space: pre-wrap; }
    .tclc-ai-msg-bot { background: #fff; border: 1px solid #e5e7eb; color: #1f2937; align-self: flex-start; }
    .tclc-ai-msg-user { background: var(--brand-blue, #2563eb); color: #fff; align-self: flex-end; }
    .tclc-ai-msg-typing { font-style: italic; color: #6b7280; }
    #tclc-ai-form { display: flex; border-top: 1px solid #e5e7eb; padding: 10px; gap: 8px; }
    #tclc-ai-input { flex: 1; border: 1px solid #d1d5db; border-radius: 20px; padding: 8px 14px; font-size: 14px; outline: none; }
    #tclc-ai-input:focus { border-color: var(--brand-blue, #2563eb); }
    #tclc-ai-send { background: var(--navy, #1a2a4a); color: #fff; border: none; border-radius: 50%; width: 38px; height: 38px; cursor: pointer; font-size: 16px; }
    #tclc-ai-send:disabled { opacity: 0.5; cursor: not-allowed; }

    @@media (max-width: 600px) {
        #tclc-ai-widget {
            bottom: 76px;
        }
    }
</style>

<script>
    (function () {
        var toggle = document.getElementById('tclc-ai-toggle');
        var panel = document.getElementById('tclc-ai-panel');
        var closeBtn = document.getElementById('tclc-ai-close');
        var form = document.getElementById('tclc-ai-form');
        var input = document.getElementById('tclc-ai-input');
        var messages = document.getElementById('tclc-ai-messages');
        var sendBtn = document.getElementById('tclc-ai-send');

        toggle.addEventListener('click', function () {
            panel.classList.toggle('tclc-ai-hidden');
            if (!panel.classList.contains('tclc-ai-hidden')) { input.focus(); }
        });

        closeBtn.addEventListener('click', function () {
            panel.classList.add('tclc-ai-hidden');
        });

        function addMessage(text, sender) {
            var div = document.createElement('div');
            div.className = 'tclc-ai-msg tclc-ai-msg-' + sender;
            div.textContent = text;
            messages.appendChild(div);
            messages.scrollTop = messages.scrollHeight;
            return div;
        }

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            var question = input.value.trim();
            if (!question) return;

            addMessage(question, 'user');
            input.value = '';
            sendBtn.disabled = true;

            var typingEl = addMessage('Typing...', 'bot');
            typingEl.classList.add('tclc-ai-msg-typing');

            try {
                var res = await fetch('/api/ai/ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question: question })
                });
                var data = await res.json();
                typingEl.remove();
                addMessage(data.answer || "Sorry, I couldn't answer that.", 'bot');
            } catch (err) {
                typingEl.remove();
                addMessage("Sorry, something went wrong. Please try again.", 'bot');
            } finally {
                sendBtn.disabled = false;
                input.focus();
            }
        });
    })();
</script>


<script>
    (function () {
        var navbarMain = document.getElementById('navbarMain');
        var chatWidget = document.getElementById('tclc-ai-widget');
        if (navbarMain && chatWidget) {
            navbarMain.addEventListener('show.bs.collapse', function () {
                chatWidget.style.display = 'none';
            });
            navbarMain.addEventListener('hide.bs.collapse', function () {
                chatWidget.style.display = '';
            });
        }
    })();
</script>




