<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The City of the Lord Church Nigeria</title>
    <meta name="description" content="The City of the Lord Church Nigeria — Bringing healing to the nations." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="data:image/png;base64,"
                         alt="TCLC Logo" height="46" width="46"
                         style="border-radius:50%;object-fit:cover;" />
                    <div style="line-height:1.15;">
                        <div style="font-family:var(--font-display);font-size:1.05rem;font-weight:900;
                            background:linear-gradient(135deg,var(--navy),var(--brand-blue));
                            -webkit-background-clip:text;-webkit-text-fill-color:transparent;
                            background-clip:text;">
                            TCLC NIGERIA
                        </div>
                        <div style="font-size:.58rem;color:var(--text-light);letter-spacing:.4px;
                            text-transform:uppercase;font-weight:500;">
                            The City of the Lord Church
                        </div>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center gap-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Ministries">Ministries</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Sermons">Sermons</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Prayer" asp-action="Index">Prayer</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                        <li class="nav-item ms-lg-2">
                            <a asp-controller="Give" asp-action="Index"
                               class="btn-hero-primary"
                               style="padding:9px 24px;font-size:.9rem;">
                                Give Online
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div style="height:80px;"></div>

    <div class="flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer style="background:var(--navy);color:rgba(255,255,255,.7);padding:4rem 0 1.5rem;">
        <div class="container">
            <div class="row g-5">

                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="data:image/png;base64,"
                             alt="TCLC Logo" height="40" width="40"
                             style="border-radius:50%;object-fit:cover;" />
                        <div>
                            <div style="font-family:var(--font-display);font-weight:900;
                                color:var(--white);font-size:1rem;">
                                TCLC Nigeria
                            </div>
                            <div style="font-size:.58rem;color:rgba(255,255,255,.4);
                                text-transform:uppercase;letter-spacing:.4px;">
                                The City of the Lord Church
                            </div>
                        </div>
                    </div>
                    <p style="color:rgba(255,255,255,.6);font-size:.88rem;line-height:1.8;margin-bottom:1rem;">
                        Bringing healing to the nations of the world, building a total man,
                        and restoring people to their destinies.
                    </p>
                    <p style="color:rgba(255,255,255,.4);font-size:.78rem;font-style:italic;margin-bottom:1rem;">
                        Founded by Rev. Dr. J.S.A Oladele
                    </p>
                    <div class="d-flex gap-2">
                        <a href="https://facebook.com/thecityofthelordchurch" target="_blank"
                           style="width:36px;height:36px;border-radius:50%;
                            background:rgba(255,255,255,.08);display:flex;
                            align-items:center;justify-content:center;
                            color:rgba(255,255,255,.7);text-decoration:none;">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="https://instagram.com/tclcnigeria" target="_blank"
                           style="width:36px;height:36px;border-radius:50%;
                            background:rgba(255,255,255,.08);display:flex;
                            align-items:center;justify-content:center;
                            color:rgba(255,255,255,.7);text-decoration:none;">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="https://www.youtube.com/@@tclcnigeria" target="_blank"
                           style="width:36px;height:36px;border-radius:50%;
                            background:rgba(255,255,255,.08);display:flex;
                            align-items:center;justify-content:center;
                            color:rgba(255,255,255,.7);text-decoration:none;">
                            <i class="bi bi-youtube"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-2 col-6">
                    <h6 style="color:var(--yellow);font-size:.8rem;font-weight:700;
                        letter-spacing:2px;text-transform:uppercase;margin-bottom:1.2rem;">
                        Quick Links
                    </h6>
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="Home" asp-action="About"
                           style="color:rgba(255,255,255,.6);text-decoration:none;font-size:.88rem;">About Us</a>
                        <a asp-controller="Home" asp-action="Sermons"
                           style="color:rgba(255,255,255,.6);text-decoration:none;font-size:.88rem;">Sermons</a>
                        <a asp-controller="Home" asp-action="Ministries"
                           style="color:rgba(255,255,255,.6);text-decoration:none;font-size:.88rem;">Ministries</a>
                        <a asp-controller="Events" asp-action="Index"
                           style="color:rgba(255,255,255,.6);text-decoration:none;font-size:.88rem;">Events</a>
                        <a asp-controller="Prayer" asp-action="Index"
                           style="color:rgba(255,255,255,.6);text-decoration:none;font-size:.88rem;">Prayer Request</a>
                        <a asp-controller="Give" asp-action="Index"
                           style="color:var(--yellow);text-decoration:none;font-size:.88rem;font-weight:600;">Give Online</a>
                        <a asp-controller="Home" asp-action="Contact"
                           style="color:rgba(255,255,255,.6);text-decoration:none;font-size:.88rem;">Contact</a>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <h6 style="color:var(--yellow);font-size:.8rem;font-weight:700;
                        letter-spacing:2px;text-transform:uppercase;margin-bottom:1.2rem;">
                        Service Times
                    </h6>
                    <div class="d-flex flex-column gap-2">
                        <div style="background:rgba(255,255,255,.05);border-radius:10px;
                            padding:.8rem 1rem;border-left:3px solid var(--yellow);">
                            <p style="color:var(--white);font-weight:600;font-size:.88rem;margin-bottom:.1rem;">
                                Sunday Service
                            </p>
                            <p style="color:rgba(255,255,255,.5);font-size:.82rem;margin:0;">10:00 AM</p>
                        </div>
                        <div style="background:rgba(255,255,255,.05);border-radius:10px;
                            padding:.8rem 1rem;border-left:3px solid var(--brand-blue);">
                            <p style="color:var(--white);font-weight:600;font-size:.88rem;margin-bottom:.1rem;">
                                Wednesday Bible Study
                            </p>
                            <p style="color:rgba(255,255,255,.5);font-size:.82rem;margin:0;">6:00 PM</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3">
                    <h6 style="color:var(--yellow);font-size:.8rem;font-weight:700;
                        letter-spacing:2px;text-transform:uppercase;margin-bottom:1.2rem;">
                        Contact Info
                    </h6>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex gap-2" style="align-items:flex-start;">
                            <i class="bi bi-geo-alt-fill"
                               style="color:var(--yellow);margin-top:3px;flex-shrink:0;"></i>
                            <p style="color:rgba(255,255,255,.6);font-size:.85rem;
                                line-height:1.7;margin:0;">
                                25, Kudirat Soule Street, off Coker Street,<br>
                                Orimolade Bus Stop, College Road,<br>
                                Ifako, Ogba, Lagos.
                            </p>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <i class="bi bi-telephone-fill"
                               style="color:var(--yellow);flex-shrink:0;"></i>
                            <a href="tel:07082768005"
                               style="color:rgba(255,255,255,.6);font-size:.88rem;text-decoration:none;">
                                07082768005
                            </a>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <i class="bi bi-envelope-fill"
                               style="color:var(--yellow);flex-shrink:0;"></i>
                            <a href="mailto:tclcnigeria@gmail.com"
                               style="color:rgba(255,255,255,.6);font-size:.88rem;text-decoration:none;">
                                tclcnigeria@gmail.com
                            </a>
                        </div>
                    </div>
                </div>

            </div>

            <div style="border-top:1px solid rgba(255,255,255,.08);margin-top:3rem;
                padding-top:1.5rem;display:flex;flex-wrap:wrap;
                justify-content:space-between;align-items:center;gap:1rem;">
                <p style="color:rgba(255,255,255,.35);font-size:.78rem;margin:0;">
                    &copy; @DateTime.Now.Year The City of The Lord Church Nigeria.
                    All Rights Reserved. Founded by Rev. Dr. J.S.A Oladele.
                </p>
                <div style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);
                    border-radius:50px;padding:4px 16px;display:inline-block;">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="d-flex gap-2 align-items-center">
                            <small style="font-size:.6rem;color:rgba(255,255,255,.35);
                                text-transform:uppercase;font-weight:700;letter-spacing:1px;">
                                Admin:
                            </small>
                            <a asp-controller="SermonsAdmin" asp-action="Index"
                               style="font-size:.72rem;color:rgba(255,255,255,.55);text-decoration:none;">
                                Sermons
                            </a>
                            <span style="color:rgba(255,255,255,.2);">|</span>
                            <a asp-controller="ContactAdmin" asp-action="Index"
                               style="font-size:.72rem;color:#f87171;text-decoration:none;">Messages</a>
                            <span style="color:rgba(255,255,255,.2);">|</span>
                            <a asp-controller="EventsAdmin" asp-action="Index"
                               style="font-size:.72rem;color:rgba(255,255,255,.55);text-decoration:none;">
                                Events
                            </a>
                            <span style="color:rgba(255,255,255,.2);">|</span>
                            <a asp-controller="PrayerAdmin" asp-action="Index"
                               style="font-size:.72rem;color:rgba(255,255,255,.55);text-decoration:none;">
                                Prayers
                            </a>
                            <span style="color:rgba(255,255,255,.2);">|</span>
                            <a asp-controller="GivingAdmin" asp-action="Index"
                               style="font-size:.72rem;color:var(--yellow);text-decoration:none;">Giving</a>
                            <span style="color:rgba(255,255,255,.2);">|</span>
                            <form asp-area="Identity" asp-page="/Account/Logout"
                                  asp-route-returnUrl="@Url.Action("Index", "Home")"
                                  method="post" class="d-inline m-0">
                                <button type="submit" class="btn btn-link p-0"
                                        style="font-size:.72rem;color:rgba(255,255,255,.55);
                                    text-decoration:none;">
                                    Logout
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login"
                           style="font-size:.72rem;color:rgba(255,255,255,.4);text-decoration:none;">
                            Admin Login
                        </a>
                    }
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>