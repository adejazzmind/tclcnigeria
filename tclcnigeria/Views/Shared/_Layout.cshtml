<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TCLC Nigeria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <!-- Using a placeholder icon if logo is missing, or replace src with your local file -->
                    <img src="~/images/tclc-logo.png" alt="Logo" height="35" class="me-2" onerror="this.style.display='none'" />
                    <span>TCLC <span class="text-gold">NIGERIA</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Ministries">Ministries</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Sermons">Sermons</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                        <li class="nav-item ms-lg-3">
                            <a asp-controller="Home" asp-action="Contact" class="btn btn-give">Give Online</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div style="height: 80px;"></div> <!-- Spacer for fixed header -->

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-hybrid">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <h5>TCLC Nigeria</h5>
                    <p>Bringing healing to the nations of the world, building a total man, and restoring people to their destinies.</p>
                    <div class="mt-4">
                        <a href="https://facebook.com/thecityofthelordchurch" target="_blank" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="https://instagram.com/tclcnigeria" target="_blank" class="social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="https://www.youtube.com/@@tclcnigeria" target="_blank" class="social-icon"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-6">
                    <h5>Quick Links</h5>
                    <a asp-controller="Home" asp-action="About" class="footer-link">About Us</a>
                    <a asp-controller="Home" asp-action="Sermons" class="footer-link">Sermons</a>
                    <a asp-controller="Home" asp-action="Ministries" class="footer-link">Ministries</a>
                    <a asp-controller="Home" asp-action="Contact" class="footer-link">Contact</a>
                </div>
                <div class="col-lg-3 col-6">
                    <h5>Service Times</h5>
                    <p class="mb-1">Sunday Service</p>
                    <p class="fw-bold mb-3">10:00 AM</p>
                    <p class="mb-1">Wednesday Bible Study</p>
                    <p class="fw-bold">6:00 PM</p>
                </div>
                <div class="col-lg-3">
                    <h5>Contact Info</h5>
                    <p class="mb-2"><i class="bi bi-geo-alt me-2"></i> 25, Kudirat Soule Str, Ifako/Ogba, Lagos</p>
                    <p class="mb-2"><i class="bi bi-telephone me-2"></i> +234 808 883 4964</p>
                    <p><i class="bi bi-envelope me-2"></i> tclcnigeria@gmail.com</p>
                </div>
            </div>
            <div class="footer-bottom mt-5 pt-4 border-top border-secondary text-center">
                <p class="small text-white-50">&copy; @DateTime.Now.Year The City Of The Lord Church Nigeria. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>