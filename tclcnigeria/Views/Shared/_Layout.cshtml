<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] — TCLC Nigeria</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#070D2E">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="TCLC Nigeria">
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png">
    <link rel="icon" type="image/png" href="/icons/icon-192x192.png">
</head>
<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/images/tclc-logo.png" alt="TCLC Nigeria Logo"
                         style="height:44px;width:44px;object-fit:contain;" />
                    <div>
                        <div style="font-family:var(--font-display);font-weight:900;font-size:1rem;
                            background:linear-gradient(135deg,var(--navy),var(--brand-blue));
                            -webkit-background-clip:text;-webkit-text-fill-color:transparent;
                            background-clip:text;line-height:1.1;">
                            TCLC NIGERIA
                        </div>
                        <div style="font-size:.62rem;color:var(--text-light);letter-spacing:1.5px;
                            text-transform:uppercase;font-weight:500;line-height:1;">
                            The City of the Lord Church
                        </div>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list" style="font-size:1.6rem;color:var(--navy);"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Ministries">Ministries</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Gallery">Gallery</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Schools</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="BibleSchool" asp-action="Index">Lord's City Bible Institute</a></li>
                                <li><a class="dropdown-item" asp-controller="Workforce" asp-action="Index">The Workforce (C.T.G.)</a></li>
                                <li><a class="dropdown-item" asp-controller="Exams" asp-action="Index">C.A. &amp; Exams</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Sermons">Sermons</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Prayer" asp-action="Index">Prayer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="https://www.youtube.com/@@tclcnigeria" target="_blank" rel="noopener" style="color:#dc2626;font-weight:600;">
                                <i class="bi bi-play-circle-fill"></i> Watch Live
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a asp-controller="Give" asp-action="Index"
                               style="display:inline-block;background:var(--yellow);color:var(--navy);
                                font-weight:700;padding:9px 24px;border-radius:50px;
                                text-decoration:none;font-size:.88rem;
                                box-shadow:0 4px 16px rgba(245,200,66,.4);
                                transition:all .25s ease;"
                               onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(245,200,66,.5)'"
                               onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 16px rgba(245,200,66,.4)'">
                                Give Online
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Responsive navbar spacer -->
    <div class="navbar-spacer"></div>

    <div class="flex-grow-1">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">
            <div class="row g-4 pb-4" style="border-bottom:1px solid rgba(255,255,255,.08);">

                <!-- Brand -->
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/tclc-logo.png" alt="TCLC Nigeria"
                             style="height:40px;width:40px;object-fit:contain;filter:none;" />
                        <div>
                            <div style="color:var(--white);font-weight:700;font-size:.95rem;
                                font-family:var(--font-display);">
                                TCLC Nigeria
                            </div>
                            <div style="font-size:.65rem;color:rgba(255,255,255,.4);
                                letter-spacing:1px;text-transform:uppercase;">
                                The City of the Lord Church
                            </div>
                        </div>
                    </div>
                    <p style="font-size:.9rem;line-height:1.8;margin-bottom:1.2rem;">
                        Bringing healing to the nations of the world, building a total man,
                        and restoring people to their destinies.
                    </p>
                    <p style="font-size:.82rem;color:rgba(255,255,255,.35);font-style:italic;">
                        Founded by Rev. Dr. J.S.A Oladele
                    </p>
                    <div class="d-flex gap-2 mt-2">
                        <a href="https://www.facebook.com/thecityofthelordchurch" target="_blank"
                           style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);
                            display:flex;align-items:center;justify-content:center;
                            color:rgba(255,255,255,.6);text-decoration:none;transition:all .2s;"
                           onmouseover="this.style.background='#1877F2';this.style.color='#fff'"
                           onmouseout="this.style.background='rgba(255,255,255,.08)';this.style.color='rgba(255,255,255,.6)'">
                            <i class="bi bi-facebook" style="font-size:.9rem;"></i>
                        </a>
                        <a href="https://instagram.com/tclcnigeria" target="_blank"
                           style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);
                            display:flex;align-items:center;justify-content:center;
                            color:rgba(255,255,255,.6);text-decoration:none;transition:all .2s;"
                           onmouseover="this.style.background='#E1306C';this.style.color='#fff'"
                           onmouseout="this.style.background='rgba(255,255,255,.08)';this.style.color='rgba(255,255,255,.6)'">
                            <i class="bi bi-instagram" style="font-size:.9rem;"></i>
                        </a>
                        <a href="https://www.youtube.com/@@tclcnigeria" target="_blank"
                           style="width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);
                            display:flex;align-items:center;justify-content:center;
                            color:rgba(255,255,255,.6);text-decoration:none;transition:all .2s;"
                           onmouseover="this.style.background='#FF0000';this.style.color='#fff'"
                           onmouseout="this.style.background='rgba(255,255,255,.08)';this.style.color='rgba(255,255,255,.6)'">
                            <i class="bi bi-youtube" style="font-size:.9rem;"></i>
                        </a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-6 col-lg-2">
                    <p style="color:var(--yellow);font-size:.72rem;font-weight:700;
                        letter-spacing:2px;text-transform:uppercase;margin-bottom:1rem;">
                        Quick Links
                    </p>
                    <ul style="list-style:none;padding:0;margin:0;">
                        <li style="margin-bottom:.5rem;">
                            <a asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                        <li style="margin-bottom:.5rem;">
                            <a asp-controller="Home" asp-action="Sermons">Sermons</a>
                        </li>
                        <li style="margin-bottom:.5rem;">
                            <a asp-controller="Home" asp-action="Ministries">Ministries</a>
                        </li>
                        <li style="margin-bottom:.5rem;">
                            <a asp-controller="Events" asp-action="Index">Events</a>
                        </li>
                        <li style="margin-bottom:.5rem;">
                            <a asp-controller="Prayer" asp-action="Index">Prayer Request</a>
                        </li>
                        <li>
                            <a asp-controller="Give" asp-action="Index"
                               style="color:var(--yellow) !important;font-weight:600;">Give Online</a>
                        </li>
                    </ul>
                </div>

                <!-- Service Times -->
                <div class="col-6 col-lg-3">
                    <p style="color:var(--yellow);font-size:.72rem;font-weight:700;
                        letter-spacing:2px;text-transform:uppercase;margin-bottom:1rem;">
                        Service Times
                    </p>
                    <div style="background:rgba(255,255,255,.04);border-radius:12px;padding:1rem;">
                        <p style="color:var(--white);font-weight:600;font-size:.82rem;margin-bottom:.3rem;">
                            Sunday Service
                        </p>
                        <p style="font-size:.8rem;margin-bottom:.8rem;">
                            1st Service &ndash; 7:30 AM<br>
                            Sunday School &ndash; 9:00&ndash;9:50 AM<br>
                            2nd Service &ndash; 10:00 AM
                        </p>
                        <p style="color:var(--white);font-weight:600;font-size:.82rem;margin-bottom:.3rem;">
                            Wednesday Service
                        </p>
                        <p style="font-size:.8rem;margin-bottom:.8rem;">
                            Faith Clinic &mdash; 10:00 AM&ndash;12:00 PM<br>
                            Bible Study &mdash; 6:00&ndash;7:30 PM
                        </p>
                        <p style="color:var(--white);font-weight:600;font-size:.82rem;margin-bottom:.3rem;">
                            Holy Ghost Miracle Hour
                        </p>
                        <p style="font-size:.8rem;margin-bottom:.8rem;">
                            Every Fortnight Tuesday &ndash; 7:00 AM
                        </p>
                        <p style="color:var(--white);font-weight:600;font-size:.82rem;margin-bottom:.3rem;">
                            Lord's Night
                        </p>
                        <p style="font-size:.8rem;margin:0;">First Friday of every month</p>
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="col-lg-3">
                    <p style="color:var(--yellow);font-size:.72rem;font-weight:700;
                        letter-spacing:2px;text-transform:uppercase;margin-bottom:1rem;">
                        Contact Info
                    </p>
                    <div class="d-flex gap-2 mb-3">
                        <i class="bi bi-geo-alt-fill" style="color:var(--yellow);margin-top:3px;flex-shrink:0;"></i>
                        <p style="font-size:.85rem;line-height:1.7;margin:0;">
                            25, Kudirat Soule Street, off Coker Street,<br>
                            Orimolade Bus Stop, College Road,<br>
                            Ifako, Ogba, Lagos.
                        </p>
                    </div>
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <i class="bi bi-telephone-fill" style="color:var(--yellow);flex-shrink:0;"></i>
                        <a href="tel:07082768005" style="font-size:.85rem;">07082768005</a>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <i class="bi bi-envelope-fill" style="color:var(--yellow);flex-shrink:0;"></i>
                        <a href="mailto:tclcnigeria@gmail.com" style="font-size:.85rem;">tclcnigeria@gmail.com</a>
                    </div>
                </div>
            </div>

            <!-- Bottom bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pt-3">
                <p style="font-size:.78rem;margin:0;">
                    &copy; @DateTime.Now.Year The City of The Lord Church Nigeria.
                    All Rights Reserved. Founded by Rev. Dr. J.S.A Oladele.
                    <br /><span style="opacity:.7;">Designed by HIGH SAM TECH</span>
                </p>
                <div class="admin-badge px-3 py-1">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <small>Signed in as <strong>@User.Identity.Name</strong></small>
                        <span style="color:rgba(255,255,255,.3);margin:0 6px;">|</span>
                        <a asp-controller="SermonsAdmin" asp-action="Index">Sermons</a>
                        <span style="color:rgba(255,255,255,.3);margin:0 6px;">|</span>
                        <a asp-controller="EventsAdmin" asp-action="Index">Events</a>
                        <span style="color:rgba(255,255,255,.3);margin:0 6px;">|</span>
                        <a asp-controller="PrayerAdmin" asp-action="Index">Prayer</a>
                        <span style="color:rgba(255,255,255,.3);margin:0 6px;">|</span>
                        <a asp-controller="ContactAdmin" asp-action="Index">Messages</a>
                        <span style="color:rgba(255,255,255,.3);margin:0 6px;">|</span>
                        <a asp-controller="BibleSchoolAdmin" asp-action="Index">Bible Institute</a>
                        <span style="color:rgba(255,255,255,.3);margin:0 6px;">|</span>
                        <a asp-controller="WorkforceAdmin" asp-action="Index">Workforce</a>
                        <span style="color:rgba(255,255,255,.3);margin:0 6px;">|</span>
                        <a asp-controller="ExamsAdmin" asp-action="Index">Exams</a>
                        <span style="color:rgba(255,255,255,.3);margin:0 6px;">|</span>
                        <form asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home")"
                              method="post" style="display:inline;">
                            <button type="submit"
                                    style="background:none;border:none;padding:0;
                                color:rgba(255,255,255,.65);cursor:pointer;font-size:inherit;">
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login">Admin Login</a>
                    }
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- PWA Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').then(function (reg) {
        console.log('TCLC SW registered:', reg.scope);
        }).catch(function (err) {
        console.log('SW registration failed:', err);
        });
        });
        }

        // PWA Install Prompt
        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        const banner = document.getElementById('pwa-banner');
        if (banner) banner.style.display = 'flex';
        });

        function installApp() {
        if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then(() => {
        deferredPrompt = null;
        const banner = document.getElementById('pwa-banner');
        if (banner) banner.style.display = 'none';
        });
        }
        }
    </script>

    <!-- PWA Install Banner -->
    <div id="pwa-banner"
         style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;
        background:#070D2E;border-top:2px solid #F5C842;
        padding:10px 16px;align-items:center;
        justify-content:space-between;gap:1rem;">
        <div style="display:flex;align-items:center;gap:10px;">
            <img src="/icons/icon-192x192.png" width="36" height="36"
                 style="border-radius:8px;" alt="TCLC Nigeria">
            <div>
                <p style="color:#fff;font-weight:700;margin:0;font-size:.88rem;">TCLC Nigeria</p>
                <p style="color:rgba(255,255,255,.6);margin:0;font-size:.75rem;">Add to home screen</p>
            </div>
        </div>
        <div style="display:flex;gap:8px;flex-shrink:0;">
            <button onclick="document.getElementById('pwa-banner').style.display='none'"
                    style="background:transparent;border:1px solid rgba(255,255,255,.3);
                color:rgba(255,255,255,.7);border-radius:50px;
                padding:5px 12px;font-size:.78rem;cursor:pointer;">
                Later
            </button>
            <button onclick="installApp()"
                    style="background:#F5C842;border:none;color:#070D2E;
                border-radius:50px;padding:5px 16px;
                font-weight:700;font-size:.78rem;cursor:pointer;">
                Install
            </button>
        </div>
    </div>

    <partial name="_AiChatWidget" />
</body>
</html>












