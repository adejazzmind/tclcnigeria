<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TCLC Nigeria</title>
    <meta name="description" content="Welcome to TCLC Nigeria — Faith, Growth, Transformation in Lagos, Nigeria." />
    <meta name="keywords" content="Church, Nigeria, Lagos, Faith, Worship, TCLC, Pastor Edwin Etomi" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    TCLC NIGERIA
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto gap-1 align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About Us</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Ministries">Ministries</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Sermons">Sermons</a></li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact"
                                   style="background:var(--brand-blue);color:#fff!important;border-radius:50px;padding:.45rem 1.4rem!important;">
                                Contact Us
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container text-center">
            <p class="mb-1" style="font-size:.78rem;">
                &copy; 2026 &nbsp;·&nbsp; <strong>TCLC Nigeria</strong> &nbsp;·&nbsp;
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </p>

            <div class="admin-badge shadow-sm d-inline-block px-3 py-1 my-1">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="d-flex gap-2 justify-content-center align-items-center">
                        <small class="text-uppercase fw-bold" style="font-size:.6rem;color:rgba(255,255,255,.5)!important;">Admin:</small>
                        <a asp-controller="SermonsAdmin" asp-action="Index" style="font-size:.72rem;">Sermons</a>
                        <span style="color:rgba(255,255,255,.3)">|</span>
                        <a asp-controller="ContactAdmin" asp-action="Index" style="font-size:.72rem;color:#f87171!important;">Messages</a>
                        <span style="color:rgba(255,255,255,.3)">|</span>
                        <form asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home")"
                              method="post" class="d-inline m-0">
                            <button type="submit" class="btn btn-link p-0"
                                    style="font-size:.72rem;color:rgba(255,255,255,.65)!important;text-decoration:none;">
                                Logout
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" style="font-size:.72rem;">Admin Login</a>
                }
            </div>

            <p class="mt-1 mb-0" style="font-size:.68rem;color:rgba(255,255,255,.4);">
                Connecting people to Christ through faith and service.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
