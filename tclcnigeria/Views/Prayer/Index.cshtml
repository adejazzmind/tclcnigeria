@model tclcnigeria.Models.PrayerRequest

@{
    ViewData["Title"] = "Prayer Request";
}

<!-- PAGE HERO -->
<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="eyebrow" style="color:var(--yellow);">Prayer Changes Things</span>
        <h1 class="mt-2 mb-3">Send Us a <em>Prayer Request</em></h1>
        <p>Our intercessory team will stand with you in prayer for 30 days.</p>
    </div>
</section>

<section style="padding:5rem 0;">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div style="background:linear-gradient(135deg,#d1fae5,#a7f3d0);
                border:1px solid #6ee7b7;border-radius:var(--r);
                color:#065f46;padding:1.5rem 2rem;margin-bottom:2rem;
                display:flex;align-items:center;gap:1rem;">
                <span style="font-size:1.8rem;">🙏</span>
                <div>
                    <p class="fw-bold mb-0">Prayer Request Received!</p>
                    <p class="mb-0" style="font-size:.93rem;">@TempData["Success"]</p>
                </div>
            </div>
        }

        <div class="row g-5 justify-content-center">
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h4 style="font-family:var(--font-display);margin-bottom:.5rem;">
                        Submit Your Prayer Request
                    </h4>
                    <p style="color:var(--text-mid);font-size:.93rem;margin-bottom:1.8rem;">
                        Whatever you're going through, you don't have to face it alone.
                    </p>

                    <form method="post" action="/Prayer">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label"
                                   style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                Your Name
                            </label>
                            <input type="text" name="Name" class="form-control"
                                   placeholder="Your full name" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label"
                                   style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                Email Address (optional)
                            </label>
                            <input type="email" name="Email" class="form-control"
                                   placeholder="name@example.com" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label"
                                   style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                Phone Number (optional)
                            </label>
                            <input type="tel" name="Phone" class="form-control"
                                   placeholder="+234 000 000 0000" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label"
                                   style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                Your Prayer Request
                            </label>
                            <textarea name="Request" class="form-control" rows="6"
                                      placeholder="Share what's on your heart..."
                                      required></textarea>
                        </div>

                        <button type="submit" class="btn-submit">
                            <i class="bi bi-send-heart me-2"></i>Send Prayer Request
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Promise Card -->
                <div style="background:linear-gradient(135deg,var(--navy),var(--navy-mid));
                    border-radius:var(--r);padding:2.5rem;margin-bottom:1.5rem;">
                    <i class="bi bi-book-half" style="font-size:2rem;color:var(--yellow);"></i>
                    <p style="font-family:var(--font-display);font-size:1.1rem;font-style:italic;
                        color:var(--white);line-height:1.7;margin:1rem 0;">
                        &ldquo;The prayer of a righteous person is powerful and effective.&rdquo;
                    </p>
                    <p style="color:var(--yellow);font-size:.82rem;font-weight:600;margin:0;">
                        — James 5:16
                    </p>
                </div>

                <!-- What Happens -->
                <div style="background:var(--white);border-radius:var(--r);padding:2rem;
                    box-shadow:var(--shadow-sm);border:1px solid rgba(201,184,232,.3);">
                    <h6 class="fw-bold mb-3" style="font-family:var(--font-display);">
                        What Happens Next
                    </h6>
                    <div class="d-flex gap-3 mb-3">
                        <div style="width:32px;height:32px;border-radius:50%;
                            background:var(--lilac-soft);display:flex;align-items:center;
                            justify-content:center;color:var(--brand-blue);
                            font-weight:700;flex-shrink:0;font-size:.85rem;">1</div>
                        <p style="color:var(--text-mid);font-size:.88rem;margin:0;padding-top:4px;">
                            Your request is received by our intercessory team
                        </p>
                    </div>
                    <div class="d-flex gap-3 mb-3">
                        <div style="width:32px;height:32px;border-radius:50%;
                            background:var(--lilac-soft);display:flex;align-items:center;
                            justify-content:center;color:var(--brand-blue);
                            font-weight:700;flex-shrink:0;font-size:.85rem;">2</div>
                        <p style="color:var(--text-mid);font-size:.88rem;margin:0;padding-top:4px;">
                            We pray with you daily for 30 days
                        </p>
                    </div>
                    <div class="d-flex gap-3">
                        <div style="width:32px;height:32px;border-radius:50%;
                            background:var(--yellow-soft);display:flex;align-items:center;
                            justify-content:center;color:var(--navy);
                            font-weight:700;flex-shrink:0;font-size:.85rem;">3</div>
                        <p style="color:var(--text-mid);font-size:.88rem;margin:0;padding-top:4px;">
                            You receive a confirmation email if you provided one
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
