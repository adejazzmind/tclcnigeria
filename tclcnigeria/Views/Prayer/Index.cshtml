@model tclcnigeria.Models.PrayerRequest

@{
    ViewData["Title"] = "Prayer Request";
}

<section class="page-hero">
    <div class="container position-relative" style="z-index:2;">
        <span class="eyebrow" style="color:var(--yellow);">We Stand With You</span>
        <h1 class="mt-2 mb-3">Submit a <em>Prayer Request</em></h1>
        <p>Share your heart with us. Our prayer team will intercede on your behalf.</p>
    </div>
</section>

<section style="padding:5rem 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                @if (TempData["Success"] != null)
                {
                    <div style="background:linear-gradient(135deg,#d1fae5,#a7f3d0);
                        border:1px solid #6ee7b7;border-radius:var(--r);
                        color:#065f46;padding:1.5rem 2rem;margin-bottom:2rem;
                        display:flex;align-items:center;gap:1rem;">
                        <span style="font-size:2rem;">🙏</span>
                        <div>
                            <strong>Request Received!</strong>
                            <p class="mb-0">@TempData["Success"]</p>
                        </div>
                    </div>
                }

                <div style="background:linear-gradient(135deg,var(--lilac-soft),var(--yellow-soft));
                    border-radius:var(--r);padding:2rem;margin-bottom:2.5rem;
                    border-left:4px solid var(--brand-blue);text-align:center;">
                    <p style="font-family:var(--font-display);font-size:1.1rem;
                        color:var(--navy);font-style:italic;margin-bottom:.5rem;">
                        "Our online prayer request opens the door, and God is waiting patiently
                        on the other side of that door, at all times, in all situations, to answer you."
                    </p>
                    <p style="color:var(--text-mid);font-size:.92rem;margin-bottom:.5rem;">
                        Your prayer request is received by our Prayer Request Team who will pray
                        on your behalf for the next 30 days.
                    </p>
                    <p style="color:var(--text-mid);font-size:.92rem;margin:0;">
                        Please know that you are a holy and precious Child of God and that
                        God is always with you.
                    </p>
                </div>

                <div class="contact-form-card">
                    <h4 style="font-family:var(--font-display);margin-bottom:1.8rem;">
                        <i class="bi bi-heart-fill me-2" style="color:var(--brand-blue);"></i>
                        We Will Love To Pray With You!
                    </h4>

                    <form asp-action="Index" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label"
                                       style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                    First Name
                                </label>
                                <input name="Name" class="form-control" placeholder="First name" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label"
                                       style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                    Last Name
                                </label>
                                <input name="LastName" class="form-control" placeholder="Last name" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"
                                   style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                Phone Number <span style="color:var(--text-light);font-weight:400;">(optional)</span>
                            </label>
                            <input name="Phone" type="tel" class="form-control"
                                   placeholder="+234 800 000 0000" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"
                                   style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                Email Address <span style="color:var(--text-light);font-weight:400;">(optional)</span>
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:.82rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label style="font-size:.88rem;font-weight:600;color:var(--text-dark);display:block;margin-bottom:.5rem;">
                                Do you prefer a phone call?
                            </label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PreferCall"
                                           id="callYes" value="Yes">
                                    <label class="form-check-label" for="callYes">Yes</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PreferCall"
                                           id="callNo" value="No" checked>
                                    <label class="form-check-label" for="callNo">No</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Request" class="form-label"
                                   style="font-size:.88rem;font-weight:600;color:var(--text-dark);">
                                Prayer Request
                            </label>
                            <textarea asp-for="Request" class="form-control" rows="6"
                                      placeholder="Share what is on your heart. Everything shared is kept in strict confidence."></textarea>
                            <span asp-validation-for="Request" class="text-danger" style="font-size:.82rem;"></span>
                        </div>

                        <div class="mb-4 d-flex align-items-center gap-2">
                            <input asp-for="IsAnonymous" class="form-check-input"
                                   id="anonCheck" style="width:18px;height:18px;">
                            <label for="anonCheck"
                                   style="font-size:.92rem;color:var(--text-mid);cursor:pointer;">
                                Submit anonymously
                            </label>
                        </div>

                        <button type="submit" class="btn-submit">
                            <i class="bi bi-send-heart me-2"></i>Submit Prayer Request
                        </button>
                    </form>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-4 text-center" style="padding:1.5rem;">
                        <div style="font-size:1.8rem;color:var(--brand-blue);margin-bottom:.5rem;">🔒</div>
                        <h6 class="fw-bold">Confidential</h6>
                        <p style="color:var(--text-mid);font-size:.85rem;margin:0;">
                            Your request is kept private within our prayer team.
                        </p>
                    </div>
                    <div class="col-md-4 text-center" style="padding:1.5rem;">
                        <div style="font-size:1.8rem;color:var(--brand-blue);margin-bottom:.5rem;">🙏</div>
                        <h6 class="fw-bold">30 Days of Prayer</h6>
                        <p style="color:var(--text-mid);font-size:.85rem;margin:0;">
                            Our intercessors pray over every request for 30 days.
                        </p>
                    </div>
                    <div class="col-md-4 text-center" style="padding:1.5rem;">
                        <div style="font-size:1.8rem;color:var(--brand-blue);margin-bottom:.5rem;">💛</div>
                        <h6 class="fw-bold">You Are Not Alone</h6>
                        <p style="color:var(--text-mid);font-size:.85rem;margin:0;">
                            The TCLC family stands with you in every season.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
