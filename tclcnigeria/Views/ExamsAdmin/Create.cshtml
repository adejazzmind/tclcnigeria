@model tclcnigeria.Models.Exam
@{
    ViewData["Title"] = "Create Exam";
}
<div class="container py-4" style="max-width:600px;">
    <h2 class="fw-bold mb-4"><i class="bi bi-plus-lg"></i> Create New Exam</h2>
    <form method="post">
        <div class="mb-3">
            <label class="form-label fw-semibold">Exam Title</label>
            <input type="text" name="Title" class="form-control" placeholder="e.g. Module 1: Foundations of Discipleship" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Description (optional)</label>
            <textarea name="Description" class="form-control" rows="3" placeholder="Brief description of this exam"></textarea>
        </div>
        <div class="mb-4">
            <label class="form-label fw-semibold">Passing Score (%)</label>
            <input type="number" name="PassingScorePercent" class="form-control" value="70" min="1" max="100" required />
        </div>
        <button type="submit" class="btn btn-primary">Create Exam &amp; Add Questions</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
