@model tclcnigeria.Models.Exam
@{
    ViewData["Title"] = "Manage Questions - " + Model.Title;
}
<div class="container py-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">&larr; Back to Exams</a>
    <h2 class="fw-bold mb-1">@Model.Title</h2>
    <p class="text-muted mb-4">Passing score: @Model.PassingScorePercent% &middot; @Model.Questions.Count question(s)</p>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Add a Question</h5>
            <form method="post" asp-action="AddQuestion">
                <input type="hidden" name="examId" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Question</label>
                    <textarea name="questionText" class="form-control" rows="2" required></textarea>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Option A</label>
                        <input type="text" name="optionA" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Option B</label>
                        <input type="text" name="optionB" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Option C (optional)</label>
                        <input type="text" name="optionC" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Option D (optional)</label>
                        <input type="text" name="optionD" class="form-control" />
                    </div>
                </div>
                <div class="mb-3" style="max-width:200px;">
                    <label class="form-label">Correct Answer</label>
                    <select name="correctOption" class="form-select" required>
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                        <option value="D">D</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Add Question</button>
            </form>
        </div>
    </div>

    <h5 class="mb-3">Questions So Far</h5>
    @if (!Model.Questions.Any())
    {
        <p class="text-muted">No questions added yet.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var q in Model.Questions)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="fw-semibold mb-2">@(q.Order + 1). @q.QuestionText</p>
                            <ul class="mb-0" style="list-style:none;padding-left:0;">
                                <li>A. @q.OptionA @(q.CorrectOption == "A" ? " ?" : "")</li>
                                <li>B. @q.OptionB @(q.CorrectOption == "B" ? " ?" : "")</li>
                                @if (!string.IsNullOrEmpty(q.OptionC))
                                {
                                    <li>C. @q.OptionC @(q.CorrectOption == "C" ? " ?" : "")</li>
                                }
                                @if (!string.IsNullOrEmpty(q.OptionD))
                                {
                                    <li>D. @q.OptionD @(q.CorrectOption == "D" ? " ?" : "")</li>
                                }
                            </ul>
                        </div>
                        <form method="post" asp-action="DeleteQuestion">
                            <input type="hidden" name="id" value="@q.Id" />
                            <input type="hidden" name="examId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
