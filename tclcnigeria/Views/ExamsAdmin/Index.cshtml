@model IEnumerable<tclcnigeria.Models.Exam>
@{
    ViewData["Title"] = "Exams";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-clipboard-check"></i> Exams</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Exam</a>
    </div>
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Questions</th>
                <th>Passing Score</th>
                <th>Status</th>
                <th>Created By</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Questions.Count</td>
                    <td>@item.PassingScorePercent%</td>
                    <td>
                        @if (item.IsPublished)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Draft</span>
                        }
                    </td>
                    <td>@(item.CreatedBy ?? "-")</td>
                    <td>
                        <a asp-action="Questions" asp-route-examId="@item.Id" class="btn btn-sm btn-outline-primary">Manage Questions</a>
                        <form method="post" asp-action="TogglePublish" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            @if (item.IsPublished)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Unpublish</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-success">Publish</button>
                            }
                        </form>
                        <form method="post" asp-action="Delete" style="display:inline;" onsubmit="return confirm('Delete this exam and all its questions?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
